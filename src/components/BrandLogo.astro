---
interface Props {
  variant?: 'nav' | 'footer';
  showSubtitle?: boolean;
}
const { variant = 'nav', showSubtitle = true } = Astro.props;
---

<div class="flex items-center gap-3 group shrink-0 select-none">
  <!-- Dynamic Luxury Automotive Logo Mark -->
  <div class={`relative ${variant === 'footer' ? 'w-9 h-9' : 'w-10 h-10'} rounded-xl p-[2px] shadow-lg flex items-center justify-center transition-all duration-300 group-hover:scale-105 group-hover:shadow-[0_0_20px_rgba(245,158,11,0.35)]`} style="background: linear-gradient(135deg, var(--color-gold) 0%, var(--color-accent) 50%, var(--color-secondary) 100%);">
    <div class="w-full h-full rounded-[9px] flex items-center justify-center relative overflow-hidden transition-colors" style={variant === 'footer' ? 'background: var(--footer-bg);' : 'background: var(--color-bg);'}>
      <!-- Precision Background Grid Lines -->
      <svg class="absolute inset-0 w-full h-full opacity-20 pointer-events-none" viewBox="0 0 40 40" fill="none">
        <circle cx="20" cy="20" r="16" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2" style="color: var(--color-gold);"/>
        <line x1="20" y1="2" x2="20" y2="38" stroke="currentColor" stroke-width="0.5" style="color: var(--color-gold);"/>
        <line x1="2" y1="20" x2="38" y2="20" stroke="currentColor" stroke-width="0.5" style="color: var(--color-gold);"/>
      </svg>
      
      <!-- Modern Automotive Search Apex Mark -->
      <svg class="w-5 h-5 relative z-10 transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Aerodynamic Caliper / Turbo Vector -->
        <path d="M4 14.5L9.5 4.5H14.5L20 14.5L16.5 19.5H7.5L4 14.5Z" stroke="url(#logo-grad-gold)" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/>
        <!-- Search Center Core / Tachometer Needle -->
        <path d="M12 8.5V13.5M12 13.5L15 16.5" stroke="var(--color-secondary)" stroke-width="1.8" stroke-linecap="round"/>
        <circle cx="12" cy="13.5" r="1.5" fill="var(--color-gold)"/>
        <!-- Velocity Wing Slash -->
        <path d="M8 11.5H16" stroke="url(#logo-grad-gold)" stroke-width="1.2" stroke-linecap="round" opacity="0.7"/>
        <defs>
          <linearGradient id="logo-grad-gold" x1="4" y1="4.5" x2="20" y2="19.5" gradientUnits="userSpaceOnUse">
            <stop stop-color="#f59e0b"/>
            <stop offset="0.5" stop-color="#fbbf24"/>
            <stop offset="1" stop-color="#0d9488"/>
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>

  <!-- Brand Typography -->
  <div class="flex flex-col">
    <span class={`font-black tracking-tight leading-tight ${variant === 'footer' ? 'text-sm' : 'text-base'}`} style={variant === 'footer' ? 'color: var(--footer-heading);' : 'color: var(--color-text-primary);'}>
      SEO <span class="text-gradient-gold">for Automotive</span>
    </span>
    {showSubtitle && (
      <span class="text-[9.5px] font-bold tracking-widest uppercase transition-colors" style={variant === 'footer' ? 'color: var(--footer-text);' : 'color: var(--color-text-muted);'}>
        Search &amp; AEO Agency
      </span>
    )}
  </div>
</div>

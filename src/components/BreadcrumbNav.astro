---
interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="container-main py-3">
  <ol class="flex items-center gap-1.5 text-sm flex-wrap" style="color: var(--color-text-muted);" itemscope itemtype="https://schema.org/BreadcrumbList">
    {items.map((item, index) => (
      <li class="flex items-center gap-1.5" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        {index > 0 && (
          <svg class="w-3.5 h-3.5 shrink-0" style="color: var(--color-text-dim);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
        )}
        {index === items.length - 1 ? (
          <span class="font-medium" style="color: var(--color-text-secondary);" itemprop="name">{item.label}</span>
        ) : (
          <a href={item.href} class="transition-colors hover:text-[var(--color-gold)]" itemprop="item">
            <span itemprop="name">{item.label}</span>
          </a>
        )}
        <meta itemprop="position" content={String(index + 1)} />
      </li>
    ))}
  </ol>
</nav>

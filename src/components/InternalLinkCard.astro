---
interface Props {
  links: { title: string; href: string; description: string; icon?: string; volume?: string }[];
  columns?: number;
}
const { links, columns = 3 } = Astro.props;
const gridClass = columns === 2 ? 'sm:grid-cols-2' : columns === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-3';
---

<div class={`grid grid-cols-1 ${gridClass} gap-4`}>
  {links.map(link => (
    <a href={link.href} class="glass-card rounded-xl p-5 group block transition-all duration-200 hover:-translate-y-0.5" id={`link-${link.href.replace(/\//g, '-').slice(1, -1)}`}>
      <div class="flex items-start gap-3.5">
        <!-- SVG Vector Badge instead of raw emojis -->
        <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5 transition-colors group-hover:scale-105" style="background: var(--color-gold-muted); border: 1px solid var(--color-gold-border); color: var(--color-gold);">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-sm font-bold truncate transition-colors group-hover:text-[var(--color-gold)]" style="color: var(--color-text-primary);">{link.title}</h3>
            <svg class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1" style="color: var(--color-text-muted);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </div>
          <p class="text-xs mt-1.5 leading-relaxed line-clamp-2" style="color: var(--color-text-secondary);">{link.description}</p>
          {link.volume && (
            <span class="badge-teal mt-2.5 text-[10px] inline-flex items-center gap-1 font-semibold">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>
              {link.volume}
            </span>
          )}
        </div>
      </div>
    </a>
  ))}
</div>

---
interface Props {
  name: string;
  role: string;
  bio: string;
  expertise?: string[];
}
const { name, role, bio, expertise = [] } = Astro.props;
---

<aside class="glass-card rounded-2xl p-6 mt-12" itemscope itemtype="https://schema.org/Person">
  <div class="flex items-start gap-4">
    <div class="w-14 h-14 rounded-xl bg-gradient-to-tr from-amber-500 to-cyan-500 p-[2px] shrink-0">
      <div class="w-full h-full rounded-[10px] bg-slate-900 flex items-center justify-center">
        <svg class="w-7 h-7 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      </div>
    </div>
    <div>
      <div class="flex items-center gap-2 mb-1">
        <h3 class="text-base font-bold text-white" itemprop="name">{name}</h3>
        <span class="px-2 py-0.5 text-[10px] font-semibold text-amber-400 bg-amber-500/10 border border-amber-500/30 rounded-full">E-E-A-T VERIFIED</span>
      </div>
      <p class="text-sm text-amber-400/80 font-medium" itemprop="jobTitle">{role}</p>
      <p class="text-sm text-slate-400 mt-2 leading-relaxed" itemprop="description">{bio}</p>
      {expertise.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {expertise.map(skill => (
            <span class="text-[10px] font-medium text-slate-400 bg-white/[0.04] border border-white/[0.08] rounded-md px-2 py-1" itemprop="knowsAbout">{skill}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</aside>

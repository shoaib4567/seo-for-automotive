---
interface Props {
  name: string;
  role: string;
  bio: string;
  expertise?: string[];
}
const { name, role, bio, expertise = [] } = Astro.props;
---

<aside class="glass-card rounded-2xl p-6 mt-12" itemscope itemtype="https://schema.org/Person">
  <div class="flex items-start gap-4">
    <div class="w-14 h-14 rounded-xl p-[2px] shrink-0" style="background: linear-gradient(135deg, var(--color-gold), var(--color-secondary));">
      <div class="w-full h-full rounded-[10px] flex items-center justify-center" style="background: var(--color-bg);">
        <svg class="w-7 h-7" style="color: var(--color-gold);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      </div>
    </div>
    <div>
      <div class="flex items-center gap-2 mb-1">
        <h3 class="text-base font-bold" style="color: var(--color-text-primary);" itemprop="name">{name}</h3>
        <span class="kw-badge text-[10px]">E-E-A-T VERIFIED</span>
      </div>
      <p class="text-sm font-medium" style="color: var(--color-gold);" itemprop="jobTitle">{role}</p>
      <p class="text-sm mt-2 leading-relaxed" style="color: var(--color-text-secondary);" itemprop="description">{bio}</p>
      {expertise.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {expertise.map(skill => (
            <span class="badge-outline text-[10px]" itemprop="knowsAbout">{skill}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</aside>

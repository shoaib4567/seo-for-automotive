---
const services = [
  { label: 'Automotive SEO', href: '/services/automotive-seo/', desc: 'Strategic organic ranking engine for auto brands', icon: '⚡' },
  { label: 'Local SEO & Maps', href: '/services/automotive-local-seo/', desc: 'GBP, Maps 3-Pack & proximity dominance', icon: '📍' },
  { label: 'Technical SEO', href: '/services/automotive-technical-seo/', desc: 'VDP/SRP crawlability, speed & schema architecture', icon: '🔧' },
  { label: 'eCommerce SEO', href: '/services/automotive-ecommerce-seo/', desc: 'Part numbers, fitment data & catalog scale', icon: '🛒' },
  { label: 'Content & Authority', href: '/services/automotive-content-seo/', desc: 'Topical authority & information-gain clusters', icon: '📝' },
  { label: 'B2B Automotive SEO', href: '/services/automotive-b2b-seo/', desc: 'Wholesale, distributor & manufacturer leads', icon: '🏭' },
  { label: 'AEO — Answer Engine', href: '/services/automotive-aeo/', desc: 'Featured snippets & Google AI Overviews', icon: '💬' },
  { label: 'GEO — AI Search', href: '/services/automotive-geo/', desc: 'ChatGPT, Gemini & Perplexity citation dominance', icon: '🤖' },
  { label: 'Reputation Management', href: '/automotive-reputation-management-services/', desc: 'Review velocity, sentiment & star rating CRO', icon: '⭐' },
];

const industries = [
  { label: 'Car Dealerships (Sales & Service)', href: '/industries/car-dealership-seo/', icon: '🚗', badge: 'High ROI' },
  { label: 'Auto Repair & Mechanics', href: '/industries/auto-repair-seo/', icon: '🛠️', badge: 'Maps 3-Pack' },
  { label: 'Auto Parts & OEM Wholesale', href: '/industries/auto-parts-seo/', icon: '⚙️', badge: 'B2B/B2C' },
  { label: 'PPF & Vinyl Wrap Brands', href: '/case-studies/vinylfrog/', icon: '✨', badge: 'AEO #1' },
  { label: 'Auto Body & Collision Shops', href: '/industries/auto-body-seo/', icon: '🚙', badge: 'Emergency' },
  { label: 'Auto Detailing & Ceramic', href: '/industries/auto-detailing-seo/', icon: '💎', badge: 'Local Luxury' },
  { label: 'Car Wash & Express Lube', href: '/industries/car-wash-seo/', icon: '🚿', badge: 'Proximity' },
];

const caseStudies = [
  { name: 'VinylFrog (B2C)', desc: 'PPF & Vinyl Wrap AEO dominance (+380% traffic, 45+ AI Overviews)', href: '/case-studies/vinylfrog/' },
  { name: 'TeckWrap (B2C)', desc: 'Global automotive film SEO & lead engine (+420% traffic)', href: '/case-studies/teckwrap/' },
  { name: 'SEJ Auto Parts (B2B)', desc: 'Wholesale parts technical architecture ($1.8M pipeline)', href: '/case-studies/sejautoparts/' },
  { name: 'BigACover (B2C)', desc: 'Custom car cover eCommerce scale (+460% organic revenue)', href: '/case-studies/bigacover/' },
];

const knowledge = [
  { label: 'Automotive SEO Strategy', href: '/blog/automotive-seo-strategy/' },
  { label: 'Semantic SEO & Vehicle Entities', href: '/blog/semantic-seo-entities/' },
  { label: 'E-E-A-T for Automotive Brands', href: '/blog/eeat-automotive-seo/' },
  { label: 'AEO: Answer Engine Optimization', href: '/blog/aeo-answer-engine-optimization/' },
  { label: 'GEO: Generative Engine Optimization', href: '/blog/geo-generative-engine-optimization/' },
  { label: 'LLMs & AI-Powered Search', href: '/blog/llm-seo-automotive/' },
  { label: 'Local SEO for Dealerships', href: '/blog/local-seo-for-automotive/' },
  { label: 'eCommerce Parts SEO Guide', href: '/blog/ecommerce-seo-automotive/' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50 backdrop-blur-xl border-b transition-colors duration-200" role="banner">
  <div class="header-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[72px]">

      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="SEO for Automotive — Home">
        <div class="logo-box w-10 h-10 rounded-xl p-[2px] shadow-lg flex items-center justify-center transition-transform group-hover:scale-105" style="background: linear-gradient(135deg, var(--color-accent), var(--color-gold));">
          <div class="w-full h-full rounded-[9px] flex items-center justify-center" style="background: var(--color-bg);">
            <svg class="w-5 h-5" style="color: var(--color-gold);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-base font-extrabold tracking-tight" style="color: var(--color-text-primary);">
            SEO <span class="text-gradient-gold">for Automotive</span>
          </span>
          <span class="text-[10px] font-semibold tracking-wider uppercase" style="color: var(--color-text-muted);">
            Specialist Search Agency
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="desktop-nav-menu items-center gap-1" role="navigation" aria-label="Main navigation">

        <!-- Services Mega Dropdown -->
        <div class="nav-dropdown-item relative group">
          <button class:list={["nav-link flex items-center gap-1.5 font-semibold text-sm", { active: currentPath.startsWith('/services') }]} aria-haspopup="true">
            Services
            <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          
          <div class="dropdown-menu-panel absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="w-[620px] p-3 rounded-2xl backdrop-blur-2xl border shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              <div class="flex items-center justify-between px-3 py-2 border-b mb-2" style="border-color: var(--color-border);">
                <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-muted);">Specialized Automotive SEO Suite</span>
                <span class="live-badge"><span class="live-dot"></span> 15+ Years Domain Depth</span>
              </div>
              <div class="grid grid-cols-3 gap-1">
                {services.map(item => (
                  <a href={item.href} class="dropdown-card flex items-start gap-2.5 p-2.5 rounded-xl transition-all hover:translate-y-[-1px]">
                    <span class="text-base mt-0.5 shrink-0" aria-hidden="true">{item.icon}</span>
                    <div>
                      <div class="text-xs font-bold" style="color: var(--color-text-primary);">{item.label}</div>
                      <div class="text-[11px] mt-0.5 line-clamp-2 leading-tight" style="color: var(--color-text-muted);">{item.desc}</div>
                    </div>
                  </a>
                ))}
              </div>
              <div class="mt-2 pt-2 border-t flex items-center justify-between px-3" style="border-color: var(--color-border);">
                <span class="text-xs" style="color: var(--color-text-muted);">Looking for bespoke enterprise automotive SEO?</span>
                <a href="/services/" class="text-xs font-bold text-gradient-gold hover:underline">View All Capabilities →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Industries Dropdown -->
        <div class="nav-dropdown-item relative group">
          <button class:list={["nav-link flex items-center gap-1.5 font-semibold text-sm", { active: currentPath.startsWith('/industries') }]} aria-haspopup="true">
            Industries
            <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="dropdown-menu-panel absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="w-[320px] p-2 rounded-2xl backdrop-blur-2xl border shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              <div class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider border-b mb-1" style="border-color: var(--color-border); color: var(--color-text-muted);">
                Automotive Verticals
              </div>
              {industries.map(v => (
                <a href={v.href} class="dropdown-card flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition-all">
                  <span class="flex items-center gap-2" style="color: var(--color-text-primary);">
                    <span>{v.icon}</span>
                    <span>{v.label}</span>
                  </span>
                  <span class="text-[10px] font-bold px-1.5 py-0.5 rounded" style="background: var(--color-gold-muted); color: var(--color-gold);">{v.badge}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Case Studies Dropdown -->
        <div class="nav-dropdown-item relative group">
          <a href="/case-studies/" class:list={["nav-link flex items-center gap-1.5 font-semibold text-sm", { active: currentPath.startsWith('/case-studies') }]}>
            Case Studies
            <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </a>
          <div class="dropdown-menu-panel absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="w-[380px] p-3 rounded-2xl backdrop-blur-2xl border shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              <div class="px-2 py-1 text-xs font-bold uppercase tracking-wider border-b mb-2" style="border-color: var(--color-border); color: var(--color-text-muted);">
                Proven Client Results
              </div>
              <div class="space-y-1">
                {caseStudies.map(cs => (
                  <a href={cs.href} class="dropdown-card block p-2.5 rounded-xl transition-all">
                    <div class="text-xs font-bold" style="color: var(--color-gold);">{cs.name}</div>
                    <div class="text-[11px] mt-0.5 leading-snug" style="color: var(--color-text-secondary);">{cs.desc}</div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Free Audit Tool -->
        <a href="/audit/" class:list={["nav-link font-semibold text-sm flex items-center gap-1.5", { active: currentPath.startsWith('/audit') }]}>
          <span class="live-dot"></span>
          Free SEO Audit
        </a>

        <!-- Knowledge -->
        <div class="nav-dropdown-item relative group">
          <button class:list={["nav-link flex items-center gap-1.5 font-semibold text-sm", { active: currentPath.startsWith('/blog') }]} aria-haspopup="true">
            Knowledge
            <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="dropdown-menu-panel absolute top-full right-0 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="w-[280px] p-2 rounded-2xl backdrop-blur-2xl border shadow-2xl max-h-[70vh] overflow-y-auto" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              <div class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider border-b mb-1" style="border-color: var(--color-border); color: var(--color-text-muted);">
                Automotive Search Guides
              </div>
              {knowledge.map(k => (
                <a href={k.href} class="dropdown-card block px-3 py-2 rounded-xl text-xs font-medium transition-colors" style="color: var(--color-text-secondary);">{k.label}</a>
              ))}
            </div>
          </div>
        </div>

        <a href="/about/" class:list={["nav-link font-semibold text-sm", { active: currentPath.startsWith('/about') }]}>About</a>
      </nav>

      <!-- Right Action Area (Theme Toggle + CTA + Mobile Hamburger) -->
      <div class="flex items-center gap-2.5">
        <!-- Theme Toggle -->
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light or dark theme" type="button" title="Switch Theme">
          <svg class="icon-sun" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <svg class="icon-moon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>

        <a href="/contact/" class="cta-nav-button hidden sm:inline-flex btn-primary text-xs font-bold py-2.5 px-4 rounded-xl shadow-md transition-transform hover:scale-105" id="nav-cta-contact">
          Get Started →
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="mobile-toggle-btn p-2 rounded-xl border transition-colors" style="border-color: var(--color-border); color: var(--color-text-primary);" aria-label="Open mobile menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="mobile-drawer hidden max-h-[85vh] overflow-y-auto px-4 py-5 border-t shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);" role="navigation" aria-label="Mobile navigation">
    <div class="space-y-4">
      <div class="flex items-center justify-between pb-3 border-b" style="border-color: var(--color-border);">
        <a href="/audit/" class="btn-gold text-xs font-bold py-2 px-3 rounded-lg w-full text-center flex items-center justify-center gap-1.5">
          <span class="live-dot"></span> Run Instant Automotive SEO Audit
        </a>
      </div>

      <div class="space-y-1">
        <a href="/" class="mobile-nav-link font-bold">Home</a>
        <a href="/about/" class="mobile-nav-link">About Us & E-E-A-T</a>
        <a href="/contact/" class="mobile-nav-link">Contact & Consultation</a>
      </div>

      <div>
        <div class="text-[11px] font-bold uppercase tracking-wider mb-2 px-3" style="color: var(--color-gold);">Our Services</div>
        <div class="grid grid-cols-1 gap-1">
          {services.map(item => (
            <a href={item.href} class="mobile-nav-link flex items-center gap-2">
              <span>{item.icon}</span>
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div>
        <div class="text-[11px] font-bold uppercase tracking-wider mb-2 px-3" style="color: var(--color-gold);">Industry Verticals</div>
        <div class="grid grid-cols-1 gap-1">
          {industries.map(v => (
            <a href={v.href} class="mobile-nav-link flex items-center justify-between">
              <span class="flex items-center gap-2">
                <span>{v.icon}</span>
                <span>{v.label}</span>
              </span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded" style="background: var(--color-gold-muted); color: var(--color-gold);">{v.badge}</span>
            </a>
          ))}
        </div>
      </div>

      <div>
        <div class="text-[11px] font-bold uppercase tracking-wider mb-2 px-3" style="color: var(--color-gold);">Featured Case Studies</div>
        <div class="grid grid-cols-1 gap-1">
          {caseStudies.map(cs => (
            <a href={cs.href} class="mobile-nav-link">
              <span class="font-bold text-xs" style="color: var(--color-gold);">{cs.name}</span>
              <span class="text-[11px] block opacity-80">{cs.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--header-bg);
    border-color: var(--header-border);
  }

  /* Desktop Menu explicit CSS */
  .desktop-nav-menu {
    display: none;
  }
  .mobile-toggle-btn {
    display: flex;
  }

  @media (min-width: 1024px) {
    .desktop-nav-menu {
      display: flex !important;
    }
    .mobile-toggle-btn {
      display: none !important;
    }
  }

  .nav-link {
    padding: 0.5rem 0.875rem;
    border-radius: 0.625rem;
    color: var(--color-text-secondary);
    transition: all 0.15s ease;
    cursor: pointer;
  }
  .nav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-surface);
  }
  .nav-link.active {
    color: var(--color-gold);
    background-color: var(--color-gold-muted);
  }

  .dropdown-card {
    color: var(--color-text-secondary);
  }
  .dropdown-card:hover {
    background-color: var(--color-bg-surface);
    color: var(--color-text-primary);
  }

  .mobile-nav-link {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: all 0.15s ease;
  }
  .mobile-nav-link:hover {
    color: var(--color-gold);
    background-color: var(--color-bg-surface);
  }
</style>

<script>
  // Theme toggle script
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile menu drawer toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    if (!menu) return;
    const isHidden = menu.classList.contains('hidden');
    if (isHidden) {
      menu.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
    } else {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });
</script>

---
import BrandLogo from './BrandLogo.astro';

const services = [
  { label: 'Automotive SEO', href: '/services/automotive-seo/', desc: 'Strategic organic ranking engine for auto brands', icon: 'bolt' },
  { label: 'Local SEO & Maps', href: '/services/automotive-local-seo/', desc: 'GBP, Maps 3-Pack & proximity dominance', icon: 'map' },
  { label: 'Technical SEO', href: '/services/automotive-technical-seo/', desc: 'VDP/SRP crawlability, speed & schema architecture', icon: 'wrench' },
  { label: 'Dealer Technical SEO', href: '/services/technical-seo-for-car-dealers/', desc: 'CDK, Dealer.com & DealerOn VDP indexation', icon: 'wrench' },
  { label: 'Link Building & PR', href: '/services/automotive-link-building/', desc: 'Tier-1 automotive editorial backlinks & SEMA PR', icon: 'bolt' },
  { label: 'eCommerce SEO', href: '/services/automotive-ecommerce-seo/', desc: 'Part numbers, fitment data & catalog scale', icon: 'cart' },
  { label: 'Content & Authority', href: '/services/automotive-content-seo/', desc: 'Topical authority & information-gain clusters', icon: 'document' },
  { label: 'B2B Automotive SEO', href: '/services/automotive-b2b-seo/', desc: 'Wholesale, distributor & manufacturer leads', icon: 'building' },
  { label: 'AEO — Answer Engine', href: '/services/automotive-aeo/', desc: 'Featured snippets & Google AI Overviews', icon: 'chat' },
  { label: 'GEO — AI Search', href: '/services/automotive-geo/', desc: 'ChatGPT, Gemini & Perplexity citation dominance', icon: 'sparkles' },
  { label: 'Reputation Management', href: '/automotive-reputation-management-services/', desc: 'Review velocity, sentiment & star rating CRO', icon: 'star' },
];

const industries = [
  { label: 'Car Dealerships (Sales & Service)', href: '/industries/car-dealership-seo/', icon: 'car', badge: 'High ROI' },
  { label: 'Auto Repair & Mechanics', href: '/industries/auto-repair-seo/', icon: 'wrench', badge: 'Maps 3-Pack' },
  { label: 'Car Rental & Exotic Fleets', href: '/industries/car-rental-seo/', icon: 'car', badge: 'Airports' },
  { label: 'Auto Parts & OEM Wholesale', href: '/industries/auto-parts-seo/', icon: 'gear', badge: 'B2B/B2C' },
  { label: 'PPF & Vinyl Wrap Brands', href: '/case-studies/vinylfrog/', icon: 'sparkles', badge: 'AEO #1' },
  { label: 'Auto Body & Collision Shops', href: '/industries/auto-body-seo/', icon: 'shield', badge: 'Emergency' },
  { label: 'Auto Detailing & Ceramic', href: '/industries/auto-detailing-seo/', icon: 'sparkles', badge: 'Local Luxury' },
  { label: 'Car Wash & Express Lube', href: '/industries/car-wash-seo/', icon: 'water', badge: 'Proximity' },
  { label: 'Commercial Truck & Fleet', href: '/truck-company-seo-services/', icon: 'truck', badge: 'Fleet B2B' },
];

const caseStudies = [
  { type: 'B2C Automotive Wrap & PPF Brand (VF)', desc: 'AEO & Google AI Overview dominance (+380% traffic, 45+ AI Overviews)', href: '/case-studies/vinylfrog/' },
  { type: 'Global Automotive Film Manufacturer (TW)', desc: 'International SEO & dealer lead acquisition (+420% traffic, +310% leads)', href: '/case-studies/teckwrap/' },
  { type: 'B2B Auto Parts & OEM Wholesale (SEJ)', desc: 'Catalog architecture & wholesale pipeline ($1.8M RFQ pipeline)', href: '/case-studies/sejautoparts/' },
  { type: 'Custom Fit Car Covers & Accessories (BAC)', desc: 'Year/Make/Model vehicle fitment eCommerce scale (+460% revenue)', href: '/case-studies/bigacover/' },
  { type: 'Local Vehicle Wraps & Fleet Graphics (Color Bomb Wraps)', desc: 'Google Maps 3-Pack & commercial fleet contracts (+540% calls, #1 rank)', href: '/case-studies/colorbombwraps/' },
];

const knowledge = [
  { label: 'Market Size & Growth Trends (2026–2030)', href: '/blog/automotive-seo-market-size-growth-trends/' },
  { label: 'Automotive SEO Strategy', href: '/blog/automotive-seo-strategy/' },
  { label: 'Semantic SEO & Vehicle Entities', href: '/blog/semantic-seo-entities/' },
  { label: 'E-E-A-T for Automotive Brands', href: '/blog/eeat-automotive-seo/' },
  { label: 'AEO: Answer Engine Optimization', href: '/blog/aeo-answer-engine-optimization/' },
  { label: 'GEO: Generative Engine Optimization', href: '/blog/geo-generative-engine-optimization/' },
  { label: 'LLMs & AI-Powered Search', href: '/blog/llm-seo-automotive/' },
  { label: 'Local SEO for Dealerships', href: '/blog/local-seo-for-automotive/' },
  { label: 'eCommerce Parts SEO Guide', href: '/blog/ecommerce-seo-automotive/' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-50 backdrop-blur-xl border-b transition-colors duration-200" role="banner">
  <div class="header-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[72px]">

      <!-- Brand Logo -->
      <a href="/" class="shrink-0" aria-label="SEO for Automotive — Home">
        <BrandLogo variant="nav" />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="desktop-nav-menu items-center gap-1" role="navigation" aria-label="Main navigation">

        <!-- Services Mega Dropdown -->
        <div class="nav-dropdown-item relative group">
          <button class:list={["nav-link flex items-center gap-1.5 font-semibold text-sm", { active: currentPath.startsWith('/services') }]} aria-haspopup="true">
            Services
            <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          
          <div class="dropdown-menu-panel absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="w-[640px] p-3 rounded-2xl backdrop-blur-2xl border shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              <div class="flex items-center justify-between px-3 py-2 border-b mb-2" style="border-color: var(--color-border);">
                <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--color-text-muted);">Specialist Automotive Search Suite</span>
                <span class="live-badge"><span class="live-dot"></span> 380+ Automotive Campaigns</span>
              </div>
              <div class="grid grid-cols-3 gap-1">
                {services.map(item => (
                  <a href={item.href} class="dropdown-card flex items-start gap-2.5 p-2.5 rounded-xl transition-all hover:translate-y-[-1px]">
                    <span class="w-6 h-6 rounded-lg flex items-center justify-center shrink-0 mt-0.5" style="background: var(--color-gold-muted); color: var(--color-gold);">
                      {item.icon === 'bolt' && <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>}
                      {item.icon === 'map' && <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>}
                      {item.icon === 'wrench' && <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.07a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091.458.117.935.07 1.405l-1.066 1.066" /></svg>}
                      {item.icon === 'cart' && <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" /></svg>}
                      {item.icon === 'document' && <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>}
                      {item.icon === 'building' && <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>}
                      {item.icon === 'chat' && <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>}
                      {item.icon === 'sparkles' && <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>}
                      {item.icon === 'star' && <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>}
                    </span>
                    <div>
                      <div class="text-xs font-bold" style="color: var(--color-text-primary);">{item.label}</div>
                      <div class="text-[11px] mt-0.5 line-clamp-2 leading-tight" style="color: var(--color-text-muted);">{item.desc}</div>
                    </div>
                  </a>
                ))}
              </div>
              <div class="mt-2 pt-2 border-t flex items-center justify-between px-3" style="border-color: var(--color-border);">
                <span class="text-xs" style="color: var(--color-text-muted);">Looking for bespoke enterprise automotive SEO?</span>
                <a href="/services/" class="text-xs font-bold text-gradient-gold hover:underline">View All Capabilities →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Industries Dropdown -->
        <div class="nav-dropdown-item relative group">
          <button class:list={["nav-link flex items-center gap-1.5 font-semibold text-sm", { active: currentPath.startsWith('/industries') }]} aria-haspopup="true">
            Industries
            <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="dropdown-menu-panel absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="w-[340px] p-2 rounded-2xl backdrop-blur-2xl border shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              <div class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider border-b mb-1" style="border-color: var(--color-border); color: var(--color-text-muted);">
                Automotive Verticals
              </div>
              {industries.map(v => (
                <a href={v.href} class="dropdown-card flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition-all">
                  <span class="flex items-center gap-2.5" style="color: var(--color-text-primary);">
                    <span class="w-5 h-5 rounded flex items-center justify-center shrink-0" style="color: var(--color-gold);">
                      {v.icon === 'car' && <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>}
                      {v.icon === 'wrench' && <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.07a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091.458.117.935.07 1.405l-1.066 1.066" /></svg>}
                      {v.icon === 'gear' && <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.27.1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.27-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.142-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>}
                      {v.icon === 'shield' && <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>}
                      {v.icon === 'sparkles' && <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>}
                      {v.icon === 'water' && <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>}
                      {v.icon === 'truck' && <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>}
                    </span>
                    <span>{v.label}</span>
                  </span>
                  <span class="text-[10px] font-bold px-1.5 py-0.5 rounded" style="background: var(--color-gold-muted); color: var(--color-gold);">{v.badge}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Case Studies Dropdown -->
        <div class="nav-dropdown-item relative group">
          <a href="/case-studies/" class:list={["nav-link flex items-center gap-1.5 font-semibold text-sm", { active: currentPath.startsWith('/case-studies') }]}>
            Case Studies
            <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </a>
          <div class="dropdown-menu-panel absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="w-[440px] p-3 rounded-2xl backdrop-blur-2xl border shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              <div class="px-2 py-1 text-xs font-bold uppercase tracking-wider border-b mb-2" style="border-color: var(--color-border); color: var(--color-text-muted);">
                Proven Automotive Case Studies
              </div>
              <div class="space-y-1">
                {caseStudies.map(cs => (
                  <a href={cs.href} class="dropdown-card block p-2.5 rounded-xl transition-all">
                    <div class="text-xs font-bold" style="color: var(--color-gold);">{cs.type}</div>
                    <div class="text-[11px] mt-0.5 leading-snug" style="color: var(--color-text-secondary);">{cs.desc}</div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Free Audit Tool -->
        <a href="/audit/" class:list={["nav-link font-semibold text-sm flex items-center gap-1.5", { active: currentPath.startsWith('/audit') }]}>
          <span class="live-dot"></span>
          Free SEO Audit
        </a>

        <!-- Knowledge -->
        <div class="nav-dropdown-item relative group">
          <button class:list={["nav-link flex items-center gap-1.5 font-semibold text-sm", { active: currentPath.startsWith('/blog') }]} aria-haspopup="true">
            Knowledge
            <svg class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="dropdown-menu-panel absolute top-full right-0 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="w-[280px] p-2 rounded-2xl backdrop-blur-2xl border shadow-2xl max-h-[70vh] overflow-y-auto" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              <div class="px-3 py-1.5 text-xs font-bold uppercase tracking-wider border-b mb-1" style="border-color: var(--color-border); color: var(--color-text-muted);">
                Automotive Search Guides
              </div>
              {knowledge.map(k => (
                <a href={k.href} class="dropdown-card block px-3 py-2 rounded-xl text-xs font-medium transition-colors" style="color: var(--color-text-secondary);">{k.label}</a>
              ))}
            </div>
          </div>
        </div>

        <a href="/about/" class:list={["nav-link font-semibold text-sm", { active: currentPath.startsWith('/about') }]}>About</a>
      </nav>

      <!-- Right Action Area (Theme Toggle + CTA + Mobile Hamburger) -->
      <div class="flex items-center gap-2.5">
        <!-- Theme Toggle -->
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light or dark theme" type="button" title="Switch Theme">
          <svg class="icon-sun" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <svg class="icon-moon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>

        <a href="/contact/" class="cta-nav-button hidden sm:inline-flex btn-primary text-xs font-bold py-2.5 px-4 rounded-xl shadow-md transition-transform hover:scale-105" id="nav-cta-contact">
          Get Started →
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="mobile-toggle-btn p-2 rounded-xl border transition-colors" style="border-color: var(--color-border); color: var(--color-text-primary);" aria-label="Open mobile menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="mobile-drawer hidden max-h-[85vh] overflow-y-auto px-4 py-5 border-t shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);" role="navigation" aria-label="Mobile navigation">
    <div class="space-y-4">
      <div class="flex items-center justify-between pb-3 border-b" style="border-color: var(--color-border);">
        <a href="/audit/" class="btn-gold text-xs font-bold py-2 px-3 rounded-lg w-full text-center flex items-center justify-center gap-1.5">
          <span class="live-dot"></span> Run Instant Automotive SEO Audit
        </a>
      </div>

      <div class="space-y-1">
        <a href="/" class="mobile-nav-link font-bold">Home</a>
        <a href="/about/" class="mobile-nav-link">About Us & E-E-A-T</a>
        <a href="/contact/" class="mobile-nav-link">Contact & Consultation</a>
      </div>

      <div>
        <div class="text-[11px] font-bold uppercase tracking-wider mb-2 px-3" style="color: var(--color-gold);">Our Services</div>
        <div class="grid grid-cols-1 gap-1">
          {services.map(item => (
            <a href={item.href} class="mobile-nav-link flex items-center gap-2">
              <span class="text-xs font-bold" style="color: var(--color-gold);">{item.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div>
        <div class="text-[11px] font-bold uppercase tracking-wider mb-2 px-3" style="color: var(--color-gold);">Industry Verticals</div>
        <div class="grid grid-cols-1 gap-1">
          {industries.map(v => (
            <a href={v.href} class="mobile-nav-link flex items-center justify-between">
              <span>{v.label}</span>
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded" style="background: var(--color-gold-muted); color: var(--color-gold);">{v.badge}</span>
            </a>
          ))}
        </div>
      </div>

      <div>
        <div class="text-[11px] font-bold uppercase tracking-wider mb-2 px-3" style="color: var(--color-gold);">Featured Case Studies</div>
        <div class="grid grid-cols-1 gap-1">
          {caseStudies.map(cs => (
            <a href={cs.href} class="mobile-nav-link">
              <span class="font-bold text-xs" style="color: var(--color-gold);">{cs.type}</span>
              <span class="text-[11px] block opacity-80">{cs.desc}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--header-bg);
    border-color: var(--header-border);
  }

  /* Desktop Menu explicit CSS */
  .desktop-nav-menu {
    display: none;
  }
  .mobile-toggle-btn {
    display: flex;
  }

  @media (min-width: 1024px) {
    .desktop-nav-menu {
      display: flex !important;
    }
    .mobile-toggle-btn {
      display: none !important;
    }
  }

  .nav-link {
    padding: 0.5rem 0.875rem;
    border-radius: 0.625rem;
    color: var(--color-text-primary);
    transition: all 0.15s ease;
    cursor: pointer;
  }
  .nav-link:hover {
    color: var(--color-gold);
    background-color: var(--color-bg-surface);
  }
  .nav-link.active {
    color: var(--color-gold);
    background-color: var(--color-gold-muted);
  }

  /* Pure CSS Dropdown Hover */
  .dropdown-menu-panel {
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    transform: translateY(4px);
  }
  .nav-dropdown-item:hover .dropdown-menu-panel {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transform: translateY(0);
  }

  .dropdown-card {
    color: var(--color-text-secondary);
  }
  .dropdown-card:hover {
    background-color: var(--color-bg-surface);
    color: var(--color-text-primary);
  }

  .mobile-nav-link {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: all 0.15s ease;
  }
  .mobile-nav-link:hover {
    color: var(--color-gold);
    background-color: var(--color-bg-surface);
  }
</style>

<script is:inline>
  (function() {
    // Theme toggle script
    var toggle = document.getElementById('theme-toggle');
    if (toggle) {
      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        var isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch(err) {}
      });
    }

    // Mobile menu drawer toggle
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var isHidden = menu.classList.contains('hidden');
        if (isHidden) {
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        } else {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  })();
</script>

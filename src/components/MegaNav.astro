---
const services = [
  {
    label: 'Automotive SEO',
    href: '/services/automotive-seo/',
    desc: 'Strategic SEO for the automotive industry',
    icon: '⚙️',
  },
  {
    label: 'Local SEO',
    href: '/services/automotive-local-seo/',
    desc: 'GBP, Maps 3-Pack & local visibility',
    icon: '📍',
  },
  {
    label: 'Technical SEO',
    href: '/services/automotive-technical-seo/',
    desc: 'Crawlability, indexation & performance',
    icon: '🔧',
  },
  {
    label: 'eCommerce SEO',
    href: '/services/automotive-ecommerce-seo/',
    desc: 'Product, category & parts store SEO',
    icon: '🛒',
  },
  {
    label: 'Content SEO',
    href: '/services/automotive-content-seo/',
    desc: 'Content strategy & topical authority',
    icon: '📝',
  },
  {
    label: 'B2B SEO',
    href: '/services/automotive-b2b-seo/',
    desc: 'Manufacturers, suppliers & distributors',
    icon: '🏭',
  },
  {
    label: 'AEO — Answer Engine',
    href: '/services/automotive-aeo/',
    desc: 'Featured snippets & AI Overviews',
    icon: '💬',
  },
  {
    label: 'GEO — AI Search',
    href: '/services/automotive-geo/',
    desc: 'ChatGPT, Gemini & LLM visibility',
    icon: '🤖',
  },
  {
    label: 'SEO Agency',
    href: '/services/automotive-seo-agency/',
    desc: 'Your specialist automotive SEO partner',
    icon: '🏢',
  },
];

const industries = [
  { label: 'Car Dealership SEO', href: '/industries/car-dealership-seo/' },
  { label: 'Auto Repair SEO', href: '/industries/auto-repair-seo/' },
  { label: 'Auto Parts SEO', href: '/industries/auto-parts-seo/' },
  { label: 'Auto Body & Collision SEO', href: '/industries/auto-body-seo/' },
  { label: 'Auto Detailing SEO', href: '/industries/auto-detailing-seo/' },
  { label: 'Car Wash SEO', href: '/industries/car-wash-seo/' },
];

const knowledge = [
  { label: 'Automotive SEO Strategy', href: '/knowledge/automotive-seo-strategy/' },
  { label: 'Semantic SEO for Automotive', href: '/knowledge/semantic-seo-automotive/' },
  { label: 'E-E-A-T for Automotive', href: '/knowledge/eeat-automotive-seo/' },
  { label: 'AEO — Answer Engine Optimization', href: '/knowledge/aeo-answer-engine-optimization/' },
  { label: 'GEO — Generative Engine', href: '/knowledge/geo-generative-engine/' },
  { label: 'LLMs & AI Search', href: '/knowledge/llm-seo-automotive/' },
  { label: 'Local SEO Guide', href: '/knowledge/local-seo-automotive/' },
  { label: 'eCommerce SEO Guide', href: '/knowledge/ecommerce-seo-automotive/' },
  { label: 'Content Strategy', href: '/knowledge/content-strategy-automotive/' },
  { label: 'Schema & Structured Data', href: '/knowledge/automotive-schema-guide/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-[#07090e]/90 backdrop-blur-xl border-b border-white/[0.06]" role="banner">
  <div class="container-main">
    <div class="flex items-center justify-between h-16 lg:h-[68px]">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="SEO for Automotive — Home">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-[#d4a853] to-[#0f9d8e] p-[2px] shadow-md">
          <div class="w-full h-full bg-[#07090e] rounded-[7px] flex items-center justify-center">
            <svg class="w-4.5 h-4.5 text-[#d4a853]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
          </div>
        </div>
        <span class="text-base font-bold tracking-tight text-white">SEO<span class="text-gradient-gold ml-1">for Automotive</span></span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-0.5" aria-label="Main navigation">
        <!-- Services Mega Dropdown -->
        <div class="relative group/mega">
          <button class:list={["nav-link flex items-center gap-1", { active: currentPath.startsWith('/services') }]} aria-haspopup="true">
            Services
            <svg class="w-3.5 h-3.5 opacity-50 group-hover/mega:opacity-100 transition-all group-hover/mega:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover/mega:opacity-100 group-hover/mega:visible transition-all duration-150 z-50">
            <div class="w-[560px] grid grid-cols-2 gap-0.5 p-2.5 rounded-xl bg-[#0c1019]/98 backdrop-blur-xl border border-white/[0.08] shadow-2xl shadow-black/50">
              {services.map(item => (
                <a href={item.href} class="flex items-start gap-2.5 p-2.5 rounded-lg hover:bg-white/[0.04] transition-colors group/item">
                  <span class="text-lg mt-0.5 shrink-0" aria-hidden="true">{item.icon}</span>
                  <div>
                    <div class="text-sm font-semibold text-slate-200 group-hover/item:text-[#d4a853] transition-colors">{item.label}</div>
                    <div class="text-xs text-slate-500 mt-0.5 leading-relaxed">{item.desc}</div>
                  </div>
                </a>
              ))}
              <a href="/services/" class="col-span-2 mt-1 px-3 py-2 rounded-lg text-xs font-semibold text-[#d4a853] hover:bg-[#d4a853]/10 transition-colors text-center border-t border-white/[0.04]">
                View All Services →
              </a>
            </div>
          </div>
        </div>

        <!-- Industries Dropdown -->
        <div class="relative group/ind">
          <button class:list={["nav-link flex items-center gap-1", { active: currentPath.startsWith('/industries') }]} aria-haspopup="true">
            Industries
            <svg class="w-3.5 h-3.5 opacity-50 group-hover/ind:opacity-100 transition-all group-hover/ind:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover/ind:opacity-100 group-hover/ind:visible transition-all duration-150 z-50">
            <div class="w-[220px] p-1.5 rounded-xl bg-[#0c1019]/98 backdrop-blur-xl border border-white/[0.08] shadow-2xl shadow-black/50">
              {industries.map(v => (
                <a href={v.href} class="block px-3 py-2 rounded-lg text-sm text-slate-300 hover:text-[#d4a853] hover:bg-white/[0.04] transition-colors">{v.label}</a>
              ))}
            </div>
          </div>
        </div>

        <a href="/tools/" class:list={["nav-link", { active: currentPath.startsWith('/tools') }]}>Tools</a>
        <a href="/results/" class:list={["nav-link", { active: currentPath.startsWith('/results') }]}>Results</a>

        <!-- Knowledge Dropdown -->
        <div class="relative group/know">
          <button class:list={["nav-link flex items-center gap-1", { active: currentPath.startsWith('/knowledge') }]} aria-haspopup="true">
            Knowledge
            <svg class="w-3.5 h-3.5 opacity-50 group-hover/know:opacity-100 transition-all group-hover/know:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute top-full right-0 pt-3 opacity-0 invisible group-hover/know:opacity-100 group-hover/know:visible transition-all duration-150 z-50">
            <div class="w-[260px] p-1.5 rounded-xl bg-[#0c1019]/98 backdrop-blur-xl border border-white/[0.08] shadow-2xl shadow-black/50 max-h-[70vh] overflow-y-auto">
              {knowledge.map(k => (
                <a href={k.href} class="block px-3 py-2 rounded-lg text-sm text-slate-300 hover:text-[#d4a853] hover:bg-white/[0.04] transition-colors">{k.label}</a>
              ))}
            </div>
          </div>
        </div>

        <a href="/about/" class:list={["nav-link", { active: currentPath.startsWith('/about') }]}>About</a>
      </nav>

      <!-- CTA + Mobile Toggle -->
      <div class="flex items-center gap-2.5">
        <a href="/contact/" class="hidden sm:flex btn-primary text-sm py-2 px-4" id="nav-cta-contact">
          Get Started
        </a>
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-white/[0.05] transition-colors" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden border-t border-white/[0.06] bg-[#07090e]/98 backdrop-blur-xl max-h-[80vh] overflow-y-auto" role="navigation" aria-label="Mobile navigation">
    <div class="px-4 py-4 space-y-0.5">
      <a href="/" class="mobile-link">Home</a>

      <div class="pt-3 pb-1 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Services</div>
      <a href="/services/" class="mobile-link font-semibold text-[#d4a853]">All Services</a>
      {services.map(item => (
        <a href={item.href} class="mobile-link">{item.icon} {item.label}</a>
      ))}

      <div class="pt-3 pb-1 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Industries</div>
      {industries.map(v => (
        <a href={v.href} class="mobile-link">{v.label}</a>
      ))}

      <div class="pt-3 pb-1 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">More</div>
      <a href="/tools/" class="mobile-link">Tools</a>
      <a href="/results/" class="mobile-link">Results</a>
      <a href="/about/" class="mobile-link">About</a>
      <a href="/contact/" class="mobile-link">Contact</a>

      <div class="pt-3 pb-1 px-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Knowledge Hub</div>
      {knowledge.map(k => (
        <a href={k.href} class="mobile-link">{k.label}</a>
      ))}
    </div>
  </div>
</header>

<style>
  .nav-link {
    @apply px-3 py-2 rounded-lg text-sm font-medium text-slate-400 hover:text-slate-200 hover:bg-white/[0.04] transition-all cursor-pointer;
  }
  .nav-link.active {
    @apply text-[#d4a853] bg-[#d4a853]/10;
  }
  .mobile-link {
    @apply block px-3 py-2.5 rounded-lg text-sm text-slate-300 hover:text-[#d4a853] hover:bg-white/[0.04] transition-colors;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const expanded = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(expanded));
  });
</script>

---
const services = [
  { label: 'Automotive SEO', href: '/services/automotive-seo/', desc: 'Strategic SEO for the automotive industry', icon: '⚙️' },
  { label: 'Local SEO', href: '/services/automotive-local-seo/', desc: 'GBP, Maps 3-Pack & local visibility', icon: '📍' },
  { label: 'Technical SEO', href: '/services/automotive-technical-seo/', desc: 'Crawlability, indexation & performance', icon: '🔧' },
  { label: 'eCommerce SEO', href: '/services/automotive-ecommerce-seo/', desc: 'Product, category & parts store SEO', icon: '🛒' },
  { label: 'Content SEO', href: '/services/automotive-content-seo/', desc: 'Content strategy & topical authority', icon: '📝' },
  { label: 'B2B SEO', href: '/services/automotive-b2b-seo/', desc: 'Manufacturers, suppliers & distributors', icon: '🏭' },
  { label: 'AEO — Answer Engine', href: '/services/automotive-aeo/', desc: 'Featured snippets & AI Overviews', icon: '💬' },
  { label: 'GEO — AI Search', href: '/services/automotive-geo/', desc: 'ChatGPT, Gemini & LLM visibility', icon: '🤖' },
  { label: 'SEO Agency', href: '/services/automotive-seo-agency/', desc: 'Your specialist automotive SEO partner', icon: '🏢' },
];

const industries = [
  { label: 'Car Dealership SEO', href: '/industries/car-dealership-seo/' },
  { label: 'Auto Repair SEO', href: '/industries/auto-repair-seo/' },
  { label: 'Auto Parts SEO', href: '/industries/auto-parts-seo/' },
  { label: 'Auto Body & Collision SEO', href: '/industries/auto-body-seo/' },
  { label: 'Auto Detailing SEO', href: '/industries/auto-detailing-seo/' },
  { label: 'Car Wash SEO', href: '/industries/car-wash-seo/' },
];

const knowledge = [
  { label: 'Automotive SEO Strategy', href: '/blog/automotive-seo-strategy/' },
  { label: 'Semantic SEO', href: '/blog/semantic-seo-entities/' },
  { label: 'E-E-A-T for Automotive', href: '/blog/eeat-automotive-seo/' },
  { label: 'AEO Guide', href: '/blog/aeo-answer-engine-optimization/' },
  { label: 'GEO Guide', href: '/blog/geo-generative-engine-optimization/' },
  { label: 'LLMs & AI Search', href: '/blog/llm-seo-automotive/' },
  { label: 'Local SEO Guide', href: '/blog/local-seo-for-automotive/' },
  { label: 'eCommerce SEO', href: '/blog/ecommerce-seo-automotive/' },
  { label: 'Content Strategy', href: '/blog/content-seo-automotive/' },
  { label: 'Holistic SEO', href: '/blog/holistic-seo-automotive/' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-xl border-b" style={`background: var(--header-bg); border-color: var(--header-border);`} role="banner">
  <div class="container-main">
    <div class="flex items-center justify-between h-16 lg:h-[68px]">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="SEO for Automotive — Home">
        <div class="w-9 h-9 rounded-lg p-[2px] shadow-md" style="background: linear-gradient(135deg, var(--color-accent), var(--color-gold));">
          <div class="w-full h-full rounded-[7px] flex items-center justify-center" style="background: var(--color-bg);">
            <svg class="w-4.5 h-4.5" style="color: var(--color-gold);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
          </div>
        </div>
        <span class="text-base font-bold tracking-tight" style="color: var(--color-text-primary);">SEO<span class="text-gradient-gold ml-1">for Automotive</span></span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-0.5" role="navigation" aria-label="Main navigation">

        <!-- Services Mega Dropdown -->
        <div class="relative group/svc">
          <button class:list={["nav-link flex items-center gap-1", { active: currentPath.startsWith('/services') }]} aria-haspopup="true">
            Services
            <svg class="w-3.5 h-3.5 opacity-50 group-hover/svc:opacity-100 transition-all group-hover/svc:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover/svc:opacity-100 group-hover/svc:visible transition-all duration-150 z-50">
            <div class="w-[580px] p-2 rounded-xl backdrop-blur-xl border shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              <div class="grid grid-cols-3 gap-0.5">
                {services.map(item => (
                  <a href={item.href} class="flex items-start gap-2.5 px-3 py-2.5 rounded-lg transition-colors" style="color: var(--color-text-secondary);" onmouseover="this.style.background='var(--color-bg-surface)'; this.style.color='var(--color-text-primary)';" onmouseout="this.style.background=''; this.style.color='var(--color-text-secondary)';">
                    <span class="text-base mt-0.5" aria-hidden="true">{item.icon}</span>
                    <div>
                      <div class="text-sm font-medium" style="color: var(--color-text-primary);">{item.label}</div>
                      <div class="text-xs mt-0.5" style="color: var(--color-text-muted);">{item.desc}</div>
                    </div>
                  </a>
                ))}
              </div>
              <div class="mt-1.5 pt-1.5" style="border-top: 1px solid var(--color-border);">
                <a href="/services/" class="block px-3 py-2 rounded-lg text-xs font-semibold text-center transition-colors" style="color: var(--color-gold);">
                  View All Services →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Industries Dropdown -->
        <div class="relative group/ind">
          <button class:list={["nav-link flex items-center gap-1", { active: currentPath.startsWith('/industries') }]} aria-haspopup="true">
            Industries
            <svg class="w-3.5 h-3.5 opacity-50 group-hover/ind:opacity-100 transition-all group-hover/ind:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover/ind:opacity-100 group-hover/ind:visible transition-all duration-150 z-50">
            <div class="w-[220px] p-1.5 rounded-xl backdrop-blur-xl border shadow-2xl" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              {industries.map(v => (
                <a href={v.href} class="block px-3 py-2 rounded-lg text-sm transition-colors" style="color: var(--color-text-secondary);" onmouseover="this.style.color='var(--color-gold)'; this.style.background='var(--color-bg-surface)';" onmouseout="this.style.color='var(--color-text-secondary)'; this.style.background='';">{v.label}</a>
              ))}
            </div>
          </div>
        </div>

        <a href="/case-studies/" class:list={["nav-link", { active: currentPath.startsWith('/case-studies') }]}>Case Studies</a>
        <a href="/audit/" class:list={["nav-link", { active: currentPath.startsWith('/audit') }]}>Free Audit</a>

        <!-- Knowledge Dropdown -->
        <div class="relative group/know">
          <button class:list={["nav-link flex items-center gap-1", { active: currentPath.startsWith('/blog') }]} aria-haspopup="true">
            Knowledge
            <svg class="w-3.5 h-3.5 opacity-50 group-hover/know:opacity-100 transition-all group-hover/know:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="absolute top-full right-0 pt-3 opacity-0 invisible group-hover/know:opacity-100 group-hover/know:visible transition-all duration-150 z-50">
            <div class="w-[260px] p-1.5 rounded-xl backdrop-blur-xl border shadow-2xl max-h-[70vh] overflow-y-auto" style="background: var(--color-bg-overlay); border-color: var(--color-border);">
              {knowledge.map(k => (
                <a href={k.href} class="block px-3 py-2 rounded-lg text-sm transition-colors" style="color: var(--color-text-secondary);" onmouseover="this.style.color='var(--color-gold)'; this.style.background='var(--color-bg-surface)';" onmouseout="this.style.color='var(--color-text-secondary)'; this.style.background='';">{k.label}</a>
              ))}
            </div>
          </div>
        </div>

        <a href="/about/" class:list={["nav-link", { active: currentPath.startsWith('/about') }]}>About</a>
      </nav>

      <!-- CTA + Theme Toggle + Mobile Toggle -->
      <div class="flex items-center gap-2">
        <!-- Theme Toggle -->
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" type="button">
          <svg class="icon-sun" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
          <svg class="icon-moon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
          </svg>
        </button>

        <a href="/contact/" class="hidden sm:flex btn-primary text-sm py-2 px-4" id="nav-cta-contact">
          Get Started
        </a>
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg transition-colors" style="color: var(--color-text-muted);" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden max-h-[80vh] overflow-y-auto" style="border-top: 1px solid var(--color-border); background: var(--color-bg-overlay);" role="navigation" aria-label="Mobile navigation">
    <div class="px-4 py-4 space-y-0.5">
      <a href="/" class="mobile-link">Home</a>

      <div class="pt-3 pb-1 px-3 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Services</div>
      <a href="/services/" class="mobile-link font-semibold" style="color: var(--color-gold);">All Services</a>
      {services.map(item => (
        <a href={item.href} class="mobile-link">{item.icon} {item.label}</a>
      ))}

      <div class="pt-3 pb-1 px-3 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Industries</div>
      {industries.map(v => (
        <a href={v.href} class="mobile-link">{v.label}</a>
      ))}

      <div class="pt-3 pb-1 px-3 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">More</div>
      <a href="/case-studies/" class="mobile-link">Case Studies</a>
      <a href="/audit/" class="mobile-link">Free Audit</a>
      <a href="/about/" class="mobile-link">About</a>
      <a href="/contact/" class="mobile-link">Contact</a>

      <div class="pt-3 pb-1 px-3 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Knowledge Hub</div>
      {knowledge.map(k => (
        <a href={k.href} class="mobile-link">{k.label}</a>
      ))}
    </div>
  </div>
</header>

<style>
  .nav-link {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  .nav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-surface);
  }
  .nav-link.active {
    color: var(--color-gold);
    background-color: var(--color-gold-muted);
  }
  .mobile-link {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-text-secondary);
    transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1), background-color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mobile-link:hover {
    color: var(--color-gold);
    background-color: var(--color-bg-surface);
  }
</style>

<script>
  // Theme toggle
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile menu
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const expanded = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(expanded));
  });
</script>

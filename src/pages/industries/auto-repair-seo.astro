---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import AuthorCard from '../../components/AuthorCard.astro';

const repairServices = [
  { title: 'Emergency & Routine Repair Hubs', desc: 'Dedicated landing pages for brake repair, transmission diagnostics, engine replacement, check engine light OBD-II codes, and A/C service.' },
  { title: 'Google Maps 3-Pack Proximity SEO', desc: 'Geo-grid radius expansion capturing high-intent "mechanic near me" and emergency roadside towing searches.' },
  { title: 'Automated Review Velocity Engines', desc: 'SMS feedback loops generating authentic 5-star Google Reviews and syndicating star ratings on search results.' },
  { title: 'Vehicle Make Specialty SEO', desc: 'Capturing high-margin European and diesel import repair searches (e.g. "BMW specialist near me", "Duramax diesel repair").' },
];

const title = "Auto Repair SEO — Mechanic & Service Shop Search Domination | SEO for Automotive";
const description = "The specialist SEO strategy for auto repair shops, independent mechanics, and tire centers. Dominate Google Maps 3-Pack, capture high-margin repair jobs, and scale shop revenue.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Auto Repair SEO', href: '/industries/auto-repair-seo/' },
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Auto Repair SEO Services",
  "description": description,
  "provider": { "@type": "Organization", "name": "SEO for Automotive", "url": "https://seoforautomotive.com" },
  "serviceType": "Search Engine Optimization for Auto Repair Shops",
  "areaServed": "United States",
};

const faqs = [
  { question: 'What is the most profitable SEO strategy for auto repair shops?', answer: 'Dominating the Google Maps 3-Pack for specific high-ticket repair services (e.g., transmission rebuilds, timing belt replacements, European auto repair) rather than generic "mechanic near me" terms. High-ticket repair searches convert at over 25% into paid repair orders.' },
  { question: 'How do you target specific vehicle makes for specialized repair shops?', answer: 'We build dedicated Make/Model specialization pages (e.g., Mercedes-Benz Certified Repair, Audi Diagnostic Services) with OEM technical data, factory scanner tooling mentions, and certified technician Schema.org markup.' },
];
---

<BaseLayout title={title} description={description} canonicalPath="/industries/auto-repair-seo/" breadcrumbs={breadcrumbs} schemaData={schemaData}>
  <div class="max-w-5xl mx-auto">

    <!-- Hero Header -->
    <div class="mb-14">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge-outline">Auto Repair & Mechanics</span>
        <span class="eeat-badge">Maps 3-Pack #1</span>
        <span class="live-badge"><span class="live-dot"></span> High-Ticket Repair Orders</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black leading-tight mb-6" style="color: var(--color-text-primary);">
        SEO for <span class="text-gradient-gold">Auto Repair Shops & Mechanics</span>
      </h1>
      
      <p class="text-lg sm:text-xl leading-relaxed" style="color: var(--color-text-secondary);">
        When drivers experience a check engine light, brake squeal, or transmission failure, they need immediate, trustworthy local service. We engineer Local SEO and Google Business Profile systems that position your repair bays at the top of local search.
      </p>
    </div>

    <!-- Visual Dashboard Banner -->
    <div class="relative rounded-2xl overflow-hidden border shadow-2xl mb-16" style="border-color: var(--color-border); background: var(--color-bg-card);">
      <img
        src="/colorbomb-local-wraps.jpg"
        alt="Auto Repair Shop Local Google Maps Rank Dominance"
        class="w-full h-auto object-cover"
        loading="eager"
      />
      <div class="p-4 border-t flex flex-wrap items-center justify-between gap-3 text-xs" style="border-color: var(--color-border); background: var(--color-bg-surface);">
        <span class="font-bold flex items-center gap-2" style="color: var(--color-text-primary);">
          <span class="live-dot"></span> Local Auto Service Authority: Google Maps 3-Pack & Emergency Diagnostic Intent
        </span>
        <span class="text-[11px] font-semibold" style="color: var(--color-gold);">AutoRepair Schema · Review Automation</span>
      </div>
    </div>

    <!-- Metrics -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">+540%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Inbound Phone Calls</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">#1</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Maps 3-Pack Placement</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">4.9★</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Verified Shop Rating</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">100%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Local Schema Accuracy</div>
      </div>
    </div>

    <!-- 4 Pillars -->
    <div class="mb-20">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="eeat-badge mb-2">Service Bay Strategy</span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-2" style="color: var(--color-text-primary);">
          How We Fill Your Auto Repair Bays
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {repairServices.map(r => (
          <div class="hud-panel p-6">
            <h3 class="text-lg font-bold mb-2" style="color: var(--color-text-primary);">{r.title}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-secondary);">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Author & E-E-A-T -->
    <div class="mb-16">
      <AuthorCard
        name="Automotive Search Engineering Team"
        role="Specialist Automotive SEO Leads"
        bio="With 15+ years dedicated exclusively to automotive search, our engineers help independent auto repair facilities and multi-location mechanic franchises dominate local market search."
        expertise={['AutoRepair Schema.org', 'Google Maps 3-Pack', 'OBD-II Diagnostic Content', 'Review Velocity Systems']}
      />
    </div>

    <!-- FAQs -->
    <div class="mb-16">
      <FaqSection items={faqs} title="Auto Repair SEO — Frequently Asked Questions" />
    </div>

    <!-- Consultation CTA -->
    <div class="hud-panel p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
        Fill your auto repair schedule with high-ticket jobs
      </h2>
      <p class="text-sm sm:text-base max-w-xl mx-auto mb-8" style="color: var(--color-text-secondary);">
        Get a specialized Google Maps 3-Pack and local repair competitor audit for your shop.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary text-sm font-bold py-3.5 px-8 rounded-xl shadow-xl w-full sm:w-auto">
          Schedule Repair Shop Consultation →
        </a>
        <a href="/audit/" class="btn-gold text-sm font-bold py-3.5 px-8 rounded-xl w-full sm:w-auto">
          Run Free Local Shop Audit
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

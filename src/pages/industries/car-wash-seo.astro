---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import AutomotiveRoiCalculator from '../../components/interactive/AutomotiveRoiCalculator.jsx';
import GeoGridSimulator from '../../components/interactive/GeoGridSimulator.jsx';
import ExecutionRoadmapTabs from '../../components/interactive/ExecutionRoadmapTabs.jsx';
import InteractiveSchemaSnippet from '../../components/interactive/InteractiveSchemaSnippet.jsx';

const washServices = [
  { title: 'Multi-Location Franchise Maps 3-Pack', desc: 'Scalable location-specific GBP optimization for express tunnel and full-service car wash networks.' },
  { title: 'Monthly Unlimited Membership Funnels', desc: 'Capturing recurring subscription intent (e.g. "unlimited car wash club near me") to maximize customer lifetime value.' },
  { title: 'Hyper-Local Geofenced Proximity SEO', desc: 'Dominating 3-to-5 mile radius commuter routes around your wash tunnels.' },
  { title: 'Review Generation & Star Rating Scale', desc: 'Automated QR code review funnels generating hundreds of 5-star Google ratings.' },
];

const title = "Car Wash SEO — Express Tunnel & Multi-Location Search | SEO for Automotive";
const description = "Specialist SEO for express car washes, full-service wash networks, and mobile car washes. Dominate Google Maps 3-Pack and scale monthly unlimited wash club memberships.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Car Wash SEO', href: '/industries/car-wash-seo/' },
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Car Wash SEO Services",
  "description": description,
  "provider": { "@type": "Organization", "name": "SEO for Automotive", "url": "https://seoforautomotive.com" },
  "serviceType": "Search Engine Optimization for Car Wash Businesses",
  "areaServed": "United States",
};

const faqs = [
  { question: 'How does SEO help car wash businesses drive recurring revenue?', answer: 'We build landing pages and promotional schema specifically targeting "unlimited car wash membership" and "monthly wash club" searches, turning one-time drive-thru visitors into recurring monthly subscribers.' },
  { question: 'How does Google Maps 3-Pack capture drive-by wash traffic?', answer: 'When drivers are commuting or running errands, mobile searches like "car wash near me" trigger instant Map cards. Having the highest review count and "Open Now" status captures immediate drive-thru traffic.' }
];
---

<BaseLayout title={title} description={description} canonicalPath="/industries/car-wash-seo/" breadcrumbs={breadcrumbs} schemaData={schemaData}>
  <div class="max-w-5xl mx-auto">

    <!-- Hero Header -->
    <div class="mb-14">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge-outline">Express & Full-Service Washes</span>
        <span class="eeat-badge">Multi-Location Scale</span>
        <span class="live-badge"><span class="live-dot"></span> Unlimited Wash Memberships</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black leading-tight mb-6" style="color: var(--color-text-primary);">
        SEO for <span class="text-gradient-gold">Car Washes & Express Tunnels</span>
      </h1>
      
      <p class="text-lg sm:text-xl leading-relaxed" style="color: var(--color-text-secondary);">
        Car wash SEO is the hyper-local search optimization of express tunnel locations, touchless facilities, and multi-unit car wash franchises, designed to dominate the Google Maps 3-Pack along commuter routes and convert local drivers into recurring monthly unlimited wash club subscribers.
      </p>
    </div>

    <!-- Metrics -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">+480%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Direction Requests</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">#1</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Maps 3-Pack Placement</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">+240%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Club Memberships</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">4.8★</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Google Review Average</div>
      </div>
    </div>

    <!-- Interactive ROI Simulator -->
    <div class="my-16">
      <AutomotiveRoiCalculator client:load defaultType="detailing" />
    </div>

    <!-- Interactive GeoGrid Simulator -->
    <div class="my-16">
      <GeoGridSimulator client:visible />
    </div>

    <!-- 4 Pillars -->
    <div class="mb-20">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="eeat-badge mb-2">Wash Network Playbook</span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-2" style="color: var(--color-text-primary);">
          How We Scale Car Wash Search Footprints
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {washServices.map(w => (
          <div class="hud-panel p-6">
            <h3 class="text-lg font-bold mb-2" style="color: var(--color-text-primary);">{w.title}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-secondary);">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Schema Snippet -->
    <div class="my-16">
      <InteractiveSchemaSnippet client:visible />
    </div>

    <!-- Execution Roadmap Tabs -->
    <div class="my-16">
      <ExecutionRoadmapTabs client:visible />
    </div>

    <!-- Author & E-E-A-T -->
    <div class="mb-16">
      <AuthorCard
        name="Automotive Search Engineering Team"
        role="Specialist Automotive SEO Leads"
        bio="Specializing in local search networks for automotive franchises, our engineers optimize multi-location car wash brands for regional search dominance."
        expertise={['Multi-Location GBP', 'Local Maps 3-Pack', 'Unlimited Club CRO', 'Local Citation Networks']}
      />
    </div>

    <!-- FAQs -->
    <div class="mb-16">
      <FaqSection items={faqs} title="Car Wash SEO — Frequently Asked Questions" />
    </div>

    <!-- Consultation CTA -->
    <div class="hud-panel p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
        Scale your car wash locations and monthly club memberships
      </h2>
      <p class="text-sm sm:text-base max-w-xl mx-auto mb-8" style="color: var(--color-text-secondary);">
        Schedule a strategic review of your car wash locations and Google Business Profile performance.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary text-sm font-bold py-3.5 px-8 rounded-xl shadow-xl w-full sm:w-auto">
          Schedule Car Wash SEO Consultation →
        </a>
        <a href="/audit/" class="btn-gold text-sm font-bold py-3.5 px-8 rounded-xl w-full sm:w-auto">
          Run Free Location Audit
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';

const dealerServices = [
  { title: 'Local SEO & Maps 3-Pack', href: '/services/automotive-local-seo/', desc: 'Multi-department GBP hierarchy (Sales, Service, Parts, Collision) & geo-grid proximity dominance.' },
  { title: 'VDP & Inventory Technical SEO', href: '/services/automotive-technical-seo/', desc: 'Real-time DMS crawl optimization, 99.8% VDP indexation, and Core Web Vitals speed tuning.' },
  { title: 'Make / Model / Year Architecture', href: '/services/automotive-content-seo/', desc: 'Topical vehicle hubs, trim-level comparison guides, and information-gain buying frameworks.' },
  { title: 'AEO & AI Overview Optimization', href: '/services/automotive-aeo/', desc: 'Capturing position zero for local dealer queries and model comparison answer boxes.' },
  { title: 'Dealer Reputation & Star CRO', href: '/automotive-reputation-management-services/', desc: 'Automated post-service SMS review capture and AggregateRating schema syndication.' },
  { title: 'Generative AI Search (GEO)', href: '/services/automotive-geo/', desc: 'Ensuring your dealership is recommended by ChatGPT, Gemini, and Apple Intelligence.' },
];

const title = "Car Dealership SEO — Specialist Dealer Search Engineering | SEO for Automotive";
const description = "The specialist search strategy for franchised and independent car dealerships. Master dynamic VDP inventory indexation, multi-department Google Maps 3-Pack, and make/model/year entity architecture.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Car Dealership SEO', href: '/industries/car-dealership-seo/' },
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Car Dealership SEO Services",
  "description": description,
  "provider": { "@type": "Organization", "name": "SEO for Automotive", "url": "https://seoforautomotive.com" },
  "serviceType": "Search Engine Optimization for Car Dealerships",
  "areaServed": "United States",
};

const faqs = [
  { question: 'How much does SEO cost for a car dealership?', answer: 'Car dealership SEO typically ranges from $2,500–$8,000/month for single-point dealerships, and $6,000–$25,000/month for multi-rooftop dealer groups. Pricing reflects inventory scale, market competitiveness, and multi-department service requirements.' },
  { question: 'Why aren\'t our dynamic vehicle detail pages (VDPs) indexing in Google?', answer: 'Dealership platforms frequently suffer from client-side JavaScript rendering issues, parameter filter crawl traps, 404 dead links upon vehicle sale, and missing Schema.org <code>Vehicle</code> markup. We engineer real-time DMS feed synchronization and canonical hygiene to guarantee 99.8% VDP indexation.' },
  { question: 'How do you structure Google Business Profiles for a franchised dealership?', answer: 'We build nested, distinct Google Business Profiles for your Sales Showroom, Service Department, Parts Counter, and Collision Center. This triples your Maps 3-Pack footprint and prevents service keywords from competing against new vehicle sales.' },
];
---

<BaseLayout title={title} description={description} canonicalPath="/industries/car-dealership-seo/" breadcrumbs={breadcrumbs} schemaData={schemaData}>
  <div class="max-w-5xl mx-auto">

    <!-- Hero Header -->
    <div class="mb-14">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge-outline">Industry Specialization</span>
        <span class="eeat-badge">Franchised & Independent</span>
        <span class="live-badge"><span class="live-dot"></span> VDP & Multi-Department SEO</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black leading-tight mb-6" style="color: var(--color-text-primary);">
        SEO for <span class="text-gradient-gold">Car Dealerships</span>
      </h1>
      
      <p class="text-lg sm:text-xl leading-relaxed" style="color: var(--color-text-secondary);">
        Dealership websites face structural search challenges that general agencies fail to understand: dynamic inventory indexation, multi-department Google Business Profiles, make/model/year entity relationships, and heavy third-party aggregator competition. We engineer dealer search engines that drive showroom walk-ins and service drive revenue.
      </p>
    </div>

    <!-- Visual Dashboard Banner -->
    <div class="relative rounded-2xl overflow-hidden border shadow-2xl mb-16" style="border-color: var(--color-border); background: var(--color-bg-card);">
      <img
        src="/cro-analytics-dashboard.jpg"
        alt="Car Dealership VDP Traffic and Lead Conversion Control Center"
        class="w-full h-auto object-cover"
        loading="eager"
      />
      <div class="p-4 border-t flex flex-wrap items-center justify-between gap-3 text-xs" style="border-color: var(--color-border); background: var(--color-bg-surface);">
        <span class="font-bold flex items-center gap-2" style="color: var(--color-text-primary);">
          <span class="live-dot"></span> Real-Time Dealership Traffic & Lead Attribution Dashboard
        </span>
        <span class="text-[11px] font-semibold" style="color: var(--color-gold);">CDK · Dealer.com · DealerInspire Integrated</span>
      </div>
    </div>

    <!-- Metrics Proof -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">99.8%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">VDP Index Rate</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">4x</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">GBP Real Estate</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">+340%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Test-Drive Inquiries</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">100%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Vehicle Schema</div>
      </div>
    </div>

    <!-- Core Strategies for Dealerships -->
    <div class="prose-content mb-16">
      <h2>The Structural Pillars of Dealership Search Dominance</h2>

      <h3>1. Dynamic VDP / SRP Inventory Crawl Optimization</h3>
      <p>Dealership inventory turns over rapidly. When cars sell, traditional DMS feeds generate 404 dead ends that bleed crawl budget. We deploy dynamic XML inventory sitemaps, automated 301 redirects to parent model SRPs, and clean parameter handling on price and trim filters.</p>

      <h3>2. Nested Vehicle & AutoDealer Schema Markup</h3>
      <p>We connect every vehicle on your lot directly into Google's Knowledge Vault with nested JSON-LD structured data including <code>VIN</code>, <code>vehicleModelDate</code>, <code>fuelType</code>, <code>mileageFromOdometer</code>, and <code>offers</code>.</p>

      <h3>3. Multi-Department Google Business Profile Scaling</h3>
      <p>We establish verified, dedicated GBP listings for your Sales Showroom, Service Department, Parts Desk, and Collision Center, dominating the Maps 3-Pack across routine maintenance, brake repairs, and vehicle sales queries simultaneously.</p>
    </div>

    <!-- Related Services Grid -->
    <div class="mb-16">
      <div class="mb-6">
        <span class="eeat-badge mb-2">Dealership SEO Modules</span>
        <h2 class="text-2xl font-bold mt-2" style="color: var(--color-text-primary);">Specialized Capabilities for Dealerships</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {dealerServices.map(s => (
          <a href={s.href} class="hud-panel p-5 block group">
            <h3 class="text-sm font-bold mb-1.5 group-hover:text-[var(--color-gold)]" style="color: var(--color-text-primary);">{s.title}</h3>
            <p class="text-xs" style="color: var(--color-text-secondary);">{s.desc}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Author & E-E-A-T -->
    <div class="mb-16">
      <AuthorCard
        name="Automotive Search Engineering Team"
        role="Specialist Automotive SEO Leads"
        bio="With 15+ years dedicated exclusively to automotive search, our engineers have managed search architectures for tier-1 franchised auto groups, independent dealerships, and global vehicle brands."
        expertise={['VDP Inventory Architecture', 'Multi-Department GBP', 'Vehicle Schema.org', 'Dealer.com / CDK SEO']}
      />
    </div>

    <!-- FAQs -->
    <div class="mb-16">
      <FaqSection items={faqs} title="Car Dealership SEO — Frequently Asked Questions" />
    </div>

    <!-- Consultation CTA -->
    <div class="hud-panel p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
        Scale your dealership's showroom walk-ins and service appointments
      </h2>
      <p class="text-sm sm:text-base max-w-xl mx-auto mb-8" style="color: var(--color-text-secondary);">
        Get a full VDP crawlability and multi-department Google Business Profile audit for your dealership.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary text-sm font-bold py-3.5 px-8 rounded-xl shadow-xl w-full sm:w-auto">
          Schedule Dealership Audit Call →
        </a>
        <a href="/audit/" class="btn-gold text-sm font-bold py-3.5 px-8 rounded-xl w-full sm:w-auto">
          Run Instant Dealer Audit
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

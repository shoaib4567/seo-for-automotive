---
import BaseLayout from '../layouts/BaseLayout.astro';
import InternalLinkCard from '../components/InternalLinkCard.astro';
import FaqSection from '../components/FaqSection.astro';
import AuthorCard from '../components/AuthorCard.astro';
import AutomotiveRoiCalculator from '../components/interactive/AutomotiveRoiCalculator.jsx';
import ComparisonMatrix from '../components/visuals/ComparisonMatrix.astro';
import ExecutionRoadmapTabs from '../components/interactive/ExecutionRoadmapTabs.jsx';
import InteractiveSchemaSnippet from '../components/interactive/InteractiveSchemaSnippet.jsx';

const title = "Automotive SEO Agency — Specialist Search & AI Engine Authority [2026]";
const description = "The specialist automotive SEO agency for dealerships, auto repair shops, parts manufacturers, and automotive eCommerce. Compare our proven track record against traditional generalist agencies.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Automotive SEO Agency', href: '/automotive-seo-agency/' },
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Automotive SEO Agency Services",
  "description": description,
  "provider": { "@type": "Organization", "name": "SEO for Automotive", "url": "https://seoforautomotive.com" },
  "serviceType": "Specialized Automotive Search Engine Optimization Agency"
};

const spokeLinks = [
  { title: 'Best Automotive SEO Agencies', href: '/best-automotive-seo-agencies/', description: 'Ranked comparison of automotive SEO agencies.', icon: '🏆', volume: 'Comparative' },
  { title: 'Automotive SEO Services & Pricing', href: '/automotive-seo-services/', description: 'Detailed SEO service packages and deliverables.', icon: '⚙️', volume: '3,990/mo' },
  { title: 'Car Dealership SEO', href: '/seo-for-car-dealerships/', description: 'VDP indexation & multi-department GBP conquest.', icon: '🚗', volume: '18,500/mo' },
  { title: 'Auto Repair SEO', href: '/auto-repair-seo-services/', description: 'High-ticket repair bay fill and local Maps 3-Pack.', icon: '🔧', volume: '8,210/mo' },
  { title: 'Auto Parts eCommerce SEO', href: '/services/automotive-ecommerce-seo/', description: 'YMM fitment & OEM part number schema.', icon: '🔩', volume: '+460% Rev' },
  { title: 'Dealership Website Providers', href: '/automotive-website-providers/', description: 'Compare Dealer.com, DealerOn, CDK vs Headless Astro.', icon: '🌐', volume: 'Platform Guide' },
];

const faqs = [
  { question: 'What makes a dedicated automotive SEO agency fundamentally superior to a general digital agency?', answer: 'General agencies apply generic blog strategies that fail to understand dynamic vehicle inventory (VDP/SRP crawlability), year/make/model compatibility databases, OEM part number cross-referencing, multi-department dealership Google Business Profile hierarchies, and automotive-specific Schema.org vocabularies.' },
  { question: 'What results can an automotive business expect from an engagement?', answer: 'Our client partners experience an average 340% increase in qualified organic test drives and service appointments, 99.8% VDP inventory indexation, and verified category leadership across Google AI Overviews and local Maps 3-Packs.' },
  { question: 'Do you work with multi-rooftop dealer groups and enterprise automotive franchises?', answer: 'Yes. We engineer centralized search architectures for multi-location dealer groups, national auto repair chains, and global automotive film and parts manufacturers across North America and international markets.' }
];
---

<BaseLayout title={title} description={description} canonicalPath="/automotive-seo-agency/" breadcrumbs={breadcrumbs} schemaData={schemaData}>

  <!-- Hero Header -->
  <div class="mb-14">
    <div class="flex items-center gap-3 mb-4">
      <span class="badge-outline">Specialist Search Authority</span>
      <span class="eeat-badge">8,610/mo Search Demand</span>
      <span class="live-badge"><span class="live-dot"></span> 380+ Verified Campaigns</span>
    </div>
    
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight" style="color: var(--color-text-primary);">
      The Specialist <span class="text-gradient-gold">Automotive SEO Agency</span>
    </h1>
    
    <p class="mt-4 text-lg text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
      We don't do dentistry or legal SEO. We engineer high-performing search ecosystems exclusively for automotive dealerships, repair shops, parts manufacturers, and automotive eCommerce brands.
    </p>
  </div>

  <!-- Key Metrics Telemetry -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
    <div class="hud-panel p-5 text-center">
      <div class="text-3xl font-black" style="color: var(--color-gold);">380+</div>
      <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Automotive Campaigns</div>
    </div>
    <div class="hud-panel p-5 text-center">
      <div class="text-3xl font-black" style="color: var(--color-gold);">&gt; $1.8M</div>
      <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Attributed Client Pipeline</div>
    </div>
    <div class="hud-panel p-5 text-center">
      <div class="text-3xl font-black" style="color: var(--color-gold);">45+</div>
      <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">AI Overview Inclusions</div>
    </div>
    <div class="hud-panel p-5 text-center">
      <div class="text-3xl font-black" style="color: var(--color-gold);">100%</div>
      <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Automotive Dedicated</div>
    </div>
  </div>

  <!-- Interactive ROI Simulator -->
  <div class="my-16">
    <AutomotiveRoiCalculator client:load defaultType="dealership" />
  </div>

  <!-- Specialist vs Generic Agency Comparison Matrix -->
  <div class="my-16">
    <ComparisonMatrix
      type="agency"
      title="Why Automotive Specialization Outperforms Traditional Agencies"
      subtitle="Compare how deep automotive domain expertise contrasts with cookie-cutter digital marketing vendors."
    />
  </div>

  <!-- Execution Roadmap Blueprint -->
  <div class="my-16">
    <ExecutionRoadmapTabs client:visible />
  </div>

  <!-- Schema Inspector -->
  <div class="my-16">
    <InteractiveSchemaSnippet client:visible />
  </div>

  <!-- Keywords Table -->
  <div class="prose-content mt-14 mb-6">
    <h2>Agency Search Demand Intelligence</h2>
  </div>

  <div class="overflow-x-auto mb-14">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-white/[0.08] text-left">
          <th class="pb-3 text-slate-600 dark:text-slate-400 font-semibold">Keyword Target</th>
          <th class="pb-3 text-slate-600 dark:text-slate-400 font-semibold text-right">Monthly Searches</th>
          <th class="pb-3 text-slate-600 dark:text-slate-400 font-semibold text-right">Intent Profile</th>
        </tr>
      </thead>
      <tbody class="text-slate-700 dark:text-slate-300">
        <tr class="border-b border-white/[0.04]"><td class="py-2.5 font-medium text-amber-400">automotive seo agency</td><td class="text-right">2,400/mo</td><td class="text-right text-emerald-400 font-mono">High Commercial</td></tr>
        <tr class="border-b border-white/[0.04]"><td class="py-2.5">automotive seo company</td><td class="text-right">1,900/mo</td><td class="text-right text-emerald-400 font-mono">Agency Search</td></tr>
        <tr class="border-b border-white/[0.04]"><td class="py-2.5">car dealership seo agency</td><td class="text-right">1,000/mo</td><td class="text-right text-emerald-400 font-mono">Franchise Intent</td></tr>
        <tr class="border-b border-white/[0.04]"><td class="py-2.5">auto repair seo company</td><td class="text-right">720/mo</td><td class="text-right text-cyan-400 font-mono">Shop Specialization</td></tr>
      </tbody>
    </table>
  </div>

  <!-- Related Spoke Hubs -->
  <div class="mt-12 mb-16">
    <h2 class="text-xl font-bold mb-6" style="color: var(--color-text-primary);">Explore Specialized Solutions</h2>
    <InternalLinkCard links={spokeLinks} columns={3} />
  </div>

  <!-- Author E-E-A-T -->
  <AuthorCard
    name="Automotive Search Engineering Team"
    role="Executive Automotive Search Strategists"
    bio="With 10+ years dedicated strictly to the automotive search landscape, our engineers lead high-impact search initiatives for dealership networks, independent shops, and global automotive aftermarket enterprises."
    expertise={['Automotive SEO Architecture', 'VDP Indexation Engineering', 'Local Maps 3-Pack Conquest', 'Google AI Overviews (AEO)']}
  />

  <!-- FAQ -->
  <FaqSection items={faqs} title="Automotive SEO Agency — Frequently Asked Questions" />

</BaseLayout>

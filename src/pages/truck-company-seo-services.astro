---
import BaseLayout from '../layouts/BaseLayout.astro';
import InternalLinkCard from '../components/InternalLinkCard.astro';
import FaqSection from '../components/FaqSection.astro';
import AuthorCard from '../components/AuthorCard.astro';

const title = "Commercial Trucking & Fleet SEO Services — Transport & Heavy Duty Logistics | SEO for Automotive";
const description = "Specialist SEO for commercial trucking companies, heavy-duty diesel repair shops, freight logistics, and commercial fleet services. Dedicated automotive and transport search authority.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Trucking & Fleet SEO', href: '/truck-company-seo-services/' }
];

const fleetServices = [
  { title: 'Commercial Freight & Shipper Intent', desc: 'Targeting high-ticket freight contracts, dedicated lane procurement, and 3PL warehousing searches.' },
  { title: 'Heavy-Duty Diesel Repair & Fleet Maintenance', desc: 'Capturing commercial fleet maintenance contracts, mobile diesel repair, and DOT inspection queries.' },
  { title: 'Multi-Terminal & Regional Depots Local SEO', desc: 'Optimizing terminal locations across interstate transit corridors for emergency fleet road service.' },
  { title: 'Commercial B2B Lead Conversion Funnels', desc: 'Streamlined freight quote calculators and fleet maintenance RFQ portals.' },
];

const faqs = [
  { question: 'Does SEO work for B2B commercial trucking and logistics?', answer: 'Yes. Commercial shippers, supply chain directors, and fleet managers regularly search for regional carriers, specialized flatbed transport, and dedicated freight contracts online. A specialized search strategy generates high-ticket corporate contract inquiries.' },
  { question: 'How do you target heavy-duty diesel repair and commercial fleet maintenance?', answer: 'We build dedicated emergency road service and commercial fleet maintenance landing pages with Schema.org <code>AutoRepair</code> markup, mobile dispatch triggers, and interstate exit targeting.' },
];
---

<BaseLayout title={title} description={description} canonicalPath="/truck-company-seo-services/" breadcrumbs={breadcrumbs}>
  <div class="max-w-5xl mx-auto">

    <!-- Hero Header -->
    <div class="mb-14">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge-outline">Commercial Fleet & Freight</span>
        <span class="eeat-badge">Heavy-Duty & Logistics</span>
        <span class="live-badge"><span class="live-dot"></span> B2B Contracts & Fleet Care</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black leading-tight mb-6" style="color: var(--color-text-primary);">
        SEO for <span class="text-gradient-gold">Commercial Trucking & Fleet Services</span>
      </h1>
      
      <p class="text-lg sm:text-xl leading-relaxed" style="color: var(--color-text-secondary);">
        Commercial freight, heavy-duty diesel maintenance, and transport logistics require specialized B2B search architecture. We build high-performing search funnels that capture shippers, fleet managers, and long-haul contracts.
      </p>
    </div>

    <!-- Metrics -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">+350%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Commercial RFQs</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">#1</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Corridor Search Rank</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">$25k+</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Avg. Contract Value</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">100%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">B2B Intent Focus</div>
      </div>
    </div>

    <!-- 4 Pillars -->
    <div class="mb-20">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="eeat-badge mb-2">Transport SEO Strategy</span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-2" style="color: var(--color-text-primary);">
          Core Pillars of Fleet & Transport Search
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {fleetServices.map(f => (
          <div class="hud-panel p-6">
            <h3 class="text-lg font-bold mb-2" style="color: var(--color-text-primary);">{f.title}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-secondary);">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Author & E-E-A-T -->
    <div class="mb-16">
      <AuthorCard
        name="Automotive Search Engineering Team"
        role="Specialist Automotive SEO Leads"
        bio="Our engineers specialize in commercial fleet and transport search campaigns, understanding freight procurement lifecycles, heavy-duty repair specifications, and regional terminal search patterns."
        expertise={['Freight RFQ Funnels', 'Heavy Duty Diesel SEO', 'Multi-Terminal GBP', 'Commercial Logistics SEO']}
      />
    </div>

    <!-- FAQs -->
    <div class="mb-16">
      <FaqSection items={faqs} title="Trucking & Transport SEO — Frequently Asked Questions" />
    </div>

    <!-- Consultation CTA -->
    <div class="hud-panel p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
        Scale your commercial freight and fleet service contracts
      </h2>
      <p class="text-sm sm:text-base max-w-xl mx-auto mb-8" style="color: var(--color-text-secondary);">
        Schedule a strategic consultation to evaluate commercial search volume in your transport corridors.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary text-sm font-bold py-3.5 px-8 rounded-xl shadow-xl w-full sm:w-auto">
          Schedule Transport SEO Call →
        </a>
        <a href="/audit/" class="btn-gold text-sm font-bold py-3.5 px-8 rounded-xl w-full sm:w-auto">
          Run Free SEO Audit
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

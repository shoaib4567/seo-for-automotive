---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';

const title = "Case Studies — Automotive SEO Results & Client Performance | SEO for Automotive";
const description = "Real automotive SEO case studies categorized by business model: B2B parts, B2C eCommerce, and Local Service franchises. See how our specialist SEO, AEO, and AI Overview strategies drive measurable growth.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Case Studies', href: '/case-studies/' },
];

const caseStudies = [
  {
    title: 'B2C Automotive Wrap & PPF Brand (VF)',
    industry: 'PPF & Vinyl Wraps (B2C)',
    href: '/case-studies/vinylfrog/',
    description: 'A leading paint protection film and vinyl wrap brand partnered with us to dominate answer engines, build unshakeable online reputation, and capture 45+ AI Overview citations across their product category.',
    metrics: [
      { value: '+380%', label: 'Organic Traffic' },
      { value: '45+', label: 'AI Overview Citations' },
      { value: '+290%', label: 'Qualified Leads' },
    ],
    tags: ['AEO', 'AI Overview', 'Reputation'],
  },
  {
    title: 'Global Automotive Film Manufacturer (TW)',
    industry: 'Automotive Film (B2C & B2B)',
    href: '/case-studies/teckwrap/',
    description: 'A global vinyl wrap and protective film manufacturer needed to break through in organic search, capture AI-powered search citations, and convert high-intent traffic into dealer and wholesale leads.',
    metrics: [
      { value: '+420%', label: 'Organic Traffic' },
      { value: '+310%', label: 'Dealer Leads' },
      { value: '60+', label: 'Featured Snippets' },
    ],
    tags: ['SEO', 'AI Overview', 'B2B Leads'],
  },
  {
    title: 'B2B Auto Parts & OEM Wholesale Distributor (SEJ)',
    industry: 'Auto Parts (B2B)',
    href: '/case-studies/sejautoparts/',
    description: 'A B2B auto parts supplier needed to establish technical authority, rank for high-value commercial part numbers, and generate qualified wholesale leads from organic search.',
    metrics: [
      { value: '+350%', label: 'Wholesale RFQs' },
      { value: '+280%', label: 'Commercial Traffic' },
      { value: '$1.8M', label: 'Pipeline Value' },
    ],
    tags: ['B2B SEO', 'Technical', 'Wholesale'],
  },
  {
    title: 'Custom Fit Car Covers & Accessories eCommerce (BAC)',
    industry: 'Car Covers & Accessories (B2C)',
    href: '/case-studies/bigacover/',
    description: 'A premium car cover and automotive protection brand partnered with us to build SEO authority in a competitive niche, manage online reputation, and drive direct-to-consumer eCommerce revenue from organic search.',
    metrics: [
      { value: '+460%', label: 'Organic Revenue' },
      { value: '4.8★', label: 'Verified Rating' },
      { value: '+340%', label: 'Keyword Footprint' },
    ],
    tags: ['eCommerce', 'Catalog SEO', 'CRO'],
  },
  {
    title: 'Local Vehicle Wraps & Fleet Graphics (Color Bomb Wraps)',
    industry: 'Local Wrap & Commercial Fleet (B2B & B2C)',
    href: '/case-studies/colorbombwraps/',
    description: 'A regional vehicle wrap and fleet graphics company partnered with us to capture the #1 Google Maps 3-Pack position across 18 zip codes and scale high-margin commercial fleet branding contracts.',
    metrics: [
      { value: '+540%', label: 'Phone & Form Inquiries' },
      { value: '#1', label: 'Maps 3-Pack Rank' },
      { value: '+320%', label: 'Commercial Fleet RFQs' },
    ],
    tags: ['Local SEO', 'Google Maps 3-Pack', 'Fleet Graphics'],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/case-studies/" breadcrumbs={breadcrumbs} noIndex={true}>

  <div class="max-w-6xl mx-auto">
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="eeat-badge">Client Performance Archive</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black leading-tight mt-2" style="color: var(--color-text-primary);">
        Case Studies & <span class="text-gradient-gold">Proven Results</span>
      </h1>
      <p class="text-base sm:text-lg mt-3 max-w-3xl leading-relaxed" style="color: var(--color-text-secondary);">
        Real automotive businesses. Real search results. Every campaign measured and verified with Google Search Console, Google Analytics 4, and enterprise rank tracking.
      </p>
    </div>

    <!-- Case Studies Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {caseStudies.map(cs => (
        <CaseStudyCard
          title={cs.title}
          industry={cs.industry}
          href={cs.href}
          metrics={cs.metrics}
          description={cs.description}
          tags={cs.tags}
        />
      ))}
    </div>

    <!-- Strategy Consultation Callout -->
    <div class="hud-panel p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
        Ready to engineer similar growth for your automotive brand?
      </h2>
      <p class="text-sm sm:text-base max-w-xl mx-auto mb-8" style="color: var(--color-text-secondary);">
        Whether you operate a B2B parts supply chain, an automotive eCommerce store, or a local service shop — let's build an unstoppable organic search engine.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary text-sm font-bold py-3.5 px-8 rounded-xl shadow-xl w-full sm:w-auto">
          Schedule Strategy Consultation →
        </a>
        <a href="/audit/" class="btn-gold text-sm font-bold py-3.5 px-8 rounded-xl w-full sm:w-auto">
          Run Free SEO Audit
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

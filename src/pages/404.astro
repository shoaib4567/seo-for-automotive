---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Page Not Found — SEO for Automotive";
const description = "The page you're looking for doesn't exist. Explore our automotive SEO services, case studies, or get a free audit.";
---

<BaseLayout title={title} description={description} canonicalPath="/404/">
  <div class="max-w-xl mx-auto text-center py-12">
    <div class="text-6xl mb-6" aria-hidden="true">🚗</div>
    <h1 class="text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
      Page not found
    </h1>
    <p class="text-lg mb-8" style="color: var(--color-text-secondary);">
      This page doesn't exist. Maybe it took a wrong turn — let's get you back on track.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href="/" class="btn-primary">Go Home</a>
      <a href="/case-studies/" class="btn-secondary">View Case Studies</a>
      <a href="/audit/" class="btn-gold">Free Audit</a>
    </div>

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
      <a href="/services/" class="glass-card rounded-lg p-4 group block">
        <h3 class="text-sm font-semibold mb-1" style="color: var(--color-text-primary);">Our Services</h3>
        <p class="text-xs" style="color: var(--color-text-muted);">Automotive SEO, Local SEO, AEO, GEO, and more.</p>
      </a>
      <a href="/contact/" class="glass-card rounded-lg p-4 group block">
        <h3 class="text-sm font-semibold mb-1" style="color: var(--color-text-primary);">Contact Us</h3>
        <p class="text-xs" style="color: var(--color-text-muted);">Start a conversation about your search goals.</p>
      </a>
    </div>
  </div>
</BaseLayout>

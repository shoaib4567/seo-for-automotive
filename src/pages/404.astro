---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | SEO for Automotive"
  description="The page you're looking for doesn't exist. Browse our automotive SEO services, industry guides, and tools."
  canonicalPath="/404/"
  noContainer={true}
>
  <section class="container-main section-spacing text-center">
    <div class="max-w-lg mx-auto">
      <span class="text-6xl font-black text-gradient-gold">404</span>
      <h1 class="text-2xl font-bold text-white mt-4 mb-3">Page not found</h1>
      <p class="text-slate-400 mb-8">
        The page you're looking for doesn't exist or has moved. Try one of these instead:
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/services/" class="btn-secondary">Explore Services</a>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 text-left">
        <a href="/industries/car-dealership-seo/" class="glass-card rounded-lg p-4 block hover:border-[#d4a853]/25">
          <div class="text-sm font-semibold text-white mb-1">Car Dealership SEO</div>
          <div class="text-xs text-slate-500">Complete dealership SEO guide</div>
        </a>
        <a href="/tools/" class="glass-card rounded-lg p-4 block hover:border-[#d4a853]/25">
          <div class="text-sm font-semibold text-white mb-1">SEO Tools</div>
          <div class="text-xs text-slate-500">Schema generator, auditors & more</div>
        </a>
        <a href="/knowledge/automotive-seo-strategy/" class="glass-card rounded-lg p-4 block hover:border-[#d4a853]/25">
          <div class="text-sm font-semibold text-white mb-1">SEO Strategy Guide</div>
          <div class="text-xs text-slate-500">Automotive SEO best practices</div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

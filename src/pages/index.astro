---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import AutomotiveAiCitationSimulator from '../components/interactive/AutomotiveAiCitationSimulator.jsx';
import AutomotiveSerpAnatomy from '../components/visuals/AutomotiveSerpAnatomy.astro';
import AutomotiveBuyerJourneyFlow from '../components/visuals/AutomotiveBuyerJourneyFlow.astro';
import AutomotiveDeliverablesMatrix from '../components/visuals/AutomotiveDeliverablesMatrix.astro';
import AutomotiveRoiCalculator from '../components/interactive/AutomotiveRoiCalculator.jsx';
import GeoGridSimulator from '../components/interactive/GeoGridSimulator.jsx';
import AutomotiveArchitectureDiagram from '../components/visuals/AutomotiveArchitectureDiagram.astro';
import ComparisonMatrix from '../components/visuals/ComparisonMatrix.astro';
import ExecutionRoadmapTabs from '../components/interactive/ExecutionRoadmapTabs.jsx';
import InteractiveSchemaSnippet from '../components/interactive/InteractiveSchemaSnippet.jsx';

const title = "SEO for Automotive — Specialist Automotive Search, AEO & AI Engine Agency";
const description = "The specialist automotive SEO and AEO authority. We engineer organic search, local Google Maps 3-Pack, and AI Overview dominance for car dealerships, repair shops, parts manufacturers, and automotive eCommerce brands.";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SEO for Automotive",
  "url": "https://seoforautomotive.com",
  "logo": "https://seoforautomotive.com/hero-hud.jpg",
  "description": description,
  "foundingDate": "2011",
  "knowsAbout": [
    "Automotive SEO", "Car Dealership SEO", "Auto Repair SEO", "Auto Parts SEO",
    "Local SEO for Automotive", "Technical SEO for Automotive", "eCommerce SEO for Automotive",
    "Answer Engine Optimization (AEO)", "Generative Engine Optimization (GEO)", "Automotive Structured Data",
    "E-E-A-T Automotive Authority", "Semantic SEO & Vehicle Entities", "Conversion Rate Optimization (CRO)"
  ]
};

const industries = [
  { title: 'Car Dealerships (Sales & Service)', href: '/industries/car-dealership-seo/', desc: 'Dynamic VDP/SRP indexation, make/model/year entity architecture, and multi-department local Maps dominance.', icon: 'car', badge: 'High Intent' },
  { title: 'Auto Repair & Mechanics', href: '/industries/auto-repair-seo/', desc: 'Local Google Maps 3-Pack capture, emergency repair query targeting, and review velocity acceleration.', icon: 'wrench', badge: 'Maps 3-Pack' },
  { title: 'Auto Parts & OEM Wholesale', href: '/industries/auto-parts-seo/', desc: 'Part number SEO, vehicle fitment databases, faceted crawl budget control, and B2B wholesale funnels.', icon: 'gear', badge: 'eCommerce & B2B' },
  { title: 'PPF & Vinyl Wrap Brands', href: '/case-studies/vinylfrog/', desc: 'High-aesthetic visual SEO, color-change wrap queries, and Google AI Overview #1 citation dominance.', icon: 'sparkles', badge: 'AEO #1' },
  { title: 'Auto Body & Collision Shops', href: '/industries/auto-body-seo/', desc: 'Local insurance-intent search capture, estimate request funnels, and geo-targeted trust architecture.', icon: 'shield', badge: 'Collision' },
  { title: 'Auto Detailing & Ceramic', href: '/industries/auto-detailing-seo/', desc: 'Luxury ceramic coating packages, paint correction search intent, and mobile booking conversion UX.', icon: 'sparkles', badge: 'Luxury Local' },
  { title: 'Car Wash & Express Lube', href: '/industries/car-wash-seo/', desc: 'Multi-location franchise visibility, monthly membership acquisition, and geofenced search dominance.', icon: 'water', badge: 'High Volume' },
  { title: 'Commercial Truck & Fleet', href: '/truck-company-seo-services/', desc: 'Heavy-duty diesel repair, fleet maintenance contracts, and commercial B2B procurement queries.', icon: 'truck', badge: 'Fleet B2B' },
];

const services = [
  { title: 'Local SEO & Maps 3-Pack', href: '/services/automotive-local-seo/', desc: 'GBP multi-category optimization, geo-grid proximity ranking, citation hygiene, and review acquisition engines.', icon: 'map', stat: '40-60% Local Clicks' },
  { title: 'Automotive Technical SEO', href: '/services/automotive-technical-seo/', desc: 'VDP crawl budget optimization, JavaScript rendering solutions, canonical taxonomy, and Core Web Vitals.', icon: 'wrench', stat: '99.8% Index Rate' },
  { title: 'Auto Parts eCommerce SEO', href: '/services/automotive-ecommerce-seo/', desc: 'SKU optimization, OEM part cross-referencing, compatibility schema, and Merchant Center free listings.', icon: 'cart', stat: '+460% Rev Growth' },
  { title: 'AEO — Answer Engine', href: '/services/automotive-aeo/', desc: 'Capturing Google AI Overviews, Featured Snippets, and People Also Ask modules for vehicle buyers.', icon: 'chat', stat: '45+ Citations' },
  { title: 'GEO — AI Search Visibility', href: '/services/automotive-geo/', desc: 'Optimizing your automotive entity for citation in ChatGPT, Google Gemini, Perplexity, and Apple Intelligence.', icon: 'sparkles', stat: 'Next-Gen Search' },
  { title: 'Reputation Management', href: '/automotive-reputation-management-services/', desc: 'Automated review capture SOPs, review schema aggregation, and trust signals that multiply conversion rates.', icon: 'star', stat: '4.9★ Average' },
];

const faqs = [
  {
    question: 'What makes specialized automotive SEO fundamentally different from general SEO agencies?',
    answer: 'Automotive SEO requires specialized knowledge of dynamic vehicle inventory management (VDP/SRP crawlability), year/make/model entity hierarchies, part number compatibility databases, multi-department dealer architectures (Sales vs Service vs Parts vs Collision), and automotive-specific schema vocabularies (<code>Vehicle</code>, <code>AutoDealer</code>, <code>AutoRepair</code>, <code>Product</code>). General agencies apply generic blog strategies that fail to index vehicle inventory or drive qualified test drives and service appointments.'
  },
  {
    question: 'How do you optimize automotive websites for Google AI Overviews, ChatGPT, and Perplexity (AEO/GEO)?',
    answer: 'We deploy an <strong>Entity-First Semantic Architecture</strong>. We establish your automotive brand as a verified entity in Google\'s Knowledge Graph using structured data, comprehensive factual entity clusters, author E-E-A-T credentials, and answer-formatted content that LLMs directly cite. For example, in our <a href="/case-studies/vinylfrog/">B2C Wrap Brand (VF) case study</a>, we captured 45+ Google AI Overview citations for top-tier automotive film queries.'
  },
  {
    question: 'What tools and data sources do you use for automotive search optimization and reporting?',
    answer: 'We don\'t report with vanity metrics. We measure real revenue impact using <strong>Google Search Console</strong> (raw impressions & clicks), <strong>Google Analytics 4</strong> (conversion tracking & phone call attribution), <strong>SEMrush & Ahrefs</strong> (market share & competitor visibility), <strong>Screaming Frog</strong> (custom automotive XPath extraction), and <strong>PageSpeed Insights API</strong> for Core Web Vitals.'
  },
  {
    question: 'How does your free automotive SEO audit work?',
    answer: 'Our <a href="/audit/">Free Automotive SEO Audit</a> analyzes your website across 5 core pillars: Technical Crawlability, Core Web Vitals, Local SEO & Google Business Profile Readiness, Schema.org Structured Data, and AEO / AI Overview Citation Readiness. It generates an instant executive scorecard with prioritized remediation steps.'
  }
];
---

<BaseLayout title={title} description={description} canonicalPath="/" schemaData={schemaData} noContainer={true}>

  <!-- ============================================ -->
  <!-- HERO SECTION WITH LUXURY AUTOMOTIVE VISUAL -->
  <!-- ============================================ -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-16 lg:pb-28">
    <!-- Ambient glowing backdrop -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full blur-[140px] opacity-30" style="background: radial-gradient(circle, var(--color-gold) 0%, var(--color-accent) 70%, transparent 100%);"></div>
      <div class="absolute top-1/2 right-0 w-[500px] h-[500px] rounded-full blur-[120px] opacity-20" style="background: var(--color-secondary);"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <!-- Top Authority Pill -->
      <div class="flex items-center justify-center mb-8">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border shadow-sm backdrop-blur-md" style="background: var(--color-bg-card); border-color: var(--color-gold-border);">
          <span class="live-dot"></span>
          <span class="text-xs font-bold tracking-wide uppercase" style="color: var(--color-gold);">380+ Verified Automotive Search Campaigns</span>
          <span class="hidden sm:inline text-xs" style="color: var(--color-text-dim);">|</span>
          <span class="hidden sm:inline text-xs font-semibold" style="color: var(--color-text-secondary);">AEO · GEO · Local Maps · CRO</span>
        </div>
      </div>

      <!-- Main Headline -->
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-6xl lg:text-[4rem] font-black tracking-tight leading-[1.08] mb-6" style="color: var(--color-text-primary);">
          Engineered to dominate <br />
          <span class="text-gradient-gold">automotive search.</span>
        </h1>

        <p class="text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto mb-10" style="color: var(--color-text-secondary);">
          We engineer high-performance organic search engines for <strong style="color: var(--color-text-primary);">dealerships, auto repair shops, parts manufacturers, and automotive eCommerce brands</strong>. From Google Maps 3-Pack to Google AI Overviews.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
          <a href="/audit/" class="btn-gold text-base py-3.5 px-7 rounded-xl shadow-xl flex items-center justify-center gap-2.5 w-full sm:w-auto font-bold transition-all hover:scale-105" id="hero-btn-audit">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.746 3.746 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
            Run Free Automotive SEO Audit
          </a>
          <a href="/contact/" class="btn-primary text-base py-3.5 px-7 rounded-xl shadow-lg flex items-center justify-center gap-2.5 w-full sm:w-auto font-bold transition-all hover:scale-105" id="hero-btn-strategy">
            Request Strategy Consultation
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>

      <!-- HERO VISUAL SHOWCASE WITH TELEMETRY HUD OVERLAYS -->
      <div class="relative rounded-2xl overflow-hidden border shadow-2xl mt-4" style="border-color: var(--color-border); background: var(--color-bg-elevated);">
        <div class="aspect-[16/9] w-full relative">
          <img
            src="/hero-hud.jpg"
            alt="Automotive Search Engineering Telemetry and Real-Time Rankings HUD"
            class="w-full h-full object-cover"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none"></div>

          <!-- Bottom Telemetry HUD Bar -->
          <div class="absolute bottom-4 left-4 right-4 grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="backdrop-blur-md rounded-xl p-3.5 sm:p-4 border bg-black/60 border-white/10 shadow-lg">
              <div class="text-xs uppercase tracking-wider text-amber-400 font-bold flex items-center gap-1.5 mb-1">
                <span class="live-dot"></span> Local Maps 3-Pack
              </div>
              <div class="text-xl sm:text-2xl font-black text-white">#1 Rank</div>
              <div class="text-[11px] text-slate-700 dark:text-slate-300">Across 18 Local Zip Codes</div>
            </div>

            <div class="backdrop-blur-md rounded-xl p-3.5 sm:p-4 border bg-black/60 border-white/10 shadow-lg">
              <div class="text-xs uppercase tracking-wider text-emerald-400 font-bold flex items-center gap-1.5 mb-1">
                AEO Dominance
              </div>
              <div class="text-xl sm:text-2xl font-black text-white">#1 Citation</div>
              <div class="text-[11px] text-slate-700 dark:text-slate-300">Google AI &amp; Perplexity</div>
            </div>

            <div class="backdrop-blur-md rounded-xl p-3.5 sm:p-4 border bg-black/60 border-white/10 shadow-lg">
              <div class="text-xs uppercase tracking-wider text-cyan-400 font-bold flex items-center gap-1.5 mb-1">
                VDP Crawl Rate
              </div>
              <div class="text-xl sm:text-2xl font-black text-white">99.8% Index</div>
              <div class="text-[11px] text-slate-700 dark:text-slate-300">Dynamic Inventory Schema</div>
            </div>

            <div class="backdrop-blur-md rounded-xl p-3.5 sm:p-4 border bg-black/60 border-white/10 shadow-lg">
              <div class="text-xs uppercase tracking-wider text-amber-400 font-bold flex items-center gap-1.5 mb-1">
                Pipeline Value
              </div>
              <div class="text-xl sm:text-2xl font-black text-white">$1.8M+ Generated</div>
              <div class="text-[11px] text-slate-700 dark:text-slate-300">B2B Auto Parts (SEJ)</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================ -->
  <!-- SIGNATURE CITELX-INSPIRED AI CITATION SIMULATOR -->
  <!-- ============================================ -->
  <section class="py-16 relative" style="background: var(--color-bg-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AutomotiveAiCitationSimulator client:load defaultCategory="dealership" />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- INTERACTIVE ROI SIMULATOR SUITE -->
  <!-- ============================================ -->
  <section class="py-16 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="eeat-badge mb-2">Automotive Revenue Forecasting</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold" style="color: var(--color-text-primary);">
          Simulate Your <span class="text-gradient-gold">Search Revenue Potential</span>
        </h2>
        <p class="text-sm sm:text-base mt-2" style="color: var(--color-text-secondary);">
          Select your automotive vertical below to model monthly showroom walk-ins, repair tickets, or online parts orders.
        </p>
      </div>

      <AutomotiveRoiCalculator client:load defaultType="dealership" />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- REAL CLIENT PROVEN RESULTS (VF, TW, SEJ, BAC, Color Bomb) -->
  <!-- ============================================ -->
  <section class="py-20 section-border" id="case-studies" style="background: var(--color-bg-elevated);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
        <div>
          <div class="inline-flex items-center gap-2 mb-3">
            <span class="eeat-badge">Verified Client Case Studies</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold" style="color: var(--color-text-primary);">
            Proven Automotive Results by <span class="text-gradient-gold">Business Model</span>
          </h2>
          <p class="text-base mt-3 max-w-2xl" style="color: var(--color-text-secondary);">
            Explore how our specialized search architecture drives category leadership for B2B distributors, B2C eCommerce brands, and local service franchises.
          </p>
        </div>
        <a href="/case-studies/" class="btn-secondary text-xs font-bold py-2.5 px-5 rounded-xl shrink-0 self-start md:self-auto">
          Explore All Case Studies →
        </a>
      </div>

      <!-- 5 Real Client Case Studies Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">

        <!-- 1. B2C Wrap Brand (VF) -->
        <div class="hud-panel p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="badge-outline">B2C Vehicle Wrap &amp; PPF</span>
              <span class="live-badge"><span class="live-dot"></span> 45+ AI Overviews</span>
            </div>
            <h3 class="text-lg font-bold mb-3" style="color: var(--color-text-primary);">
              B2C Automotive Wrap &amp; PPF Brand (VF)
            </h3>
            <p class="text-xs leading-relaxed mb-6" style="color: var(--color-text-secondary);">
              Captured the #1 snippet &amp; AI Overview position across hundreds of high-intent vinyl wrap colors, vehicle wrap maintenance, and PPF installation queries.
            </p>
            <div class="grid grid-cols-3 gap-2 p-3 rounded-xl mb-6 text-center" style="background: var(--color-bg-surface);">
              <div>
                <div class="text-xl font-black" style="color: var(--color-gold);">+380%</div>
                <div class="text-[10px] font-semibold" style="color: var(--color-text-muted);">Traffic</div>
              </div>
              <div>
                <div class="text-xl font-black" style="color: var(--color-gold);">45+</div>
                <div class="text-[10px] font-semibold" style="color: var(--color-text-muted);">AI Citations</div>
              </div>
              <div>
                <div class="text-xl font-black" style="color: var(--color-gold);">4.9★</div>
                <div class="text-[10px] font-semibold" style="color: var(--color-text-muted);">Trust</div>
              </div>
            </div>
          </div>
          <a href="/case-studies/vinylfrog/" class="text-xs font-bold text-gradient-gold flex items-center gap-1.5 hover:underline">
            Read B2C Wrap Case Study →
          </a>
        </div>

        <!-- 2. Global Film Manufacturer (TW) -->
        <div class="hud-panel p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="badge-outline">Automotive Film (B2C &amp; B2B)</span>
              <span class="live-badge"><span class="live-dot"></span> +310% Leads</span>
            </div>
            <h3 class="text-lg font-bold mb-3" style="color: var(--color-text-primary);">
              Global Automotive Film Manufacturer (TW)
            </h3>
            <p class="text-xs leading-relaxed mb-6" style="color: var(--color-text-secondary);">
              Engineered topical authority clusters for commercial vehicle wrap shops and global distributors, turning organic search into their highest-performing B2B channel.
            </p>
            <div class="grid grid-cols-3 gap-2 p-3 rounded-xl mb-6 text-center" style="background: var(--color-bg-surface);">
              <div>
                <div class="text-xl font-black" style="color: var(--color-gold);">+420%</div>
                <div class="text-[10px] font-semibold" style="color: var(--color-text-muted);">Traffic</div>
              </div>
              <div>
                <div class="text-xl font-black" style="color: var(--color-gold);">+310%</div>
                <div class="text-[10px] font-semibold" style="color: var(--color-text-muted);">Dealer RFQs</div>
              </div>
              <div>
                <div class="text-xl font-black" style="color: var(--color-gold);">60+</div>
                <div class="text-[10px] font-semibold" style="color: var(--color-text-muted);">Snippets</div>
              </div>
            </div>
          </div>
          <a href="/case-studies/teckwrap/" class="text-xs font-bold text-gradient-gold flex items-center gap-1.5 hover:underline">
            Read Global Film Case Study →
          </a>
        </div>

        <!-- 3. B2B Auto Parts Wholesale (SEJ) -->
        <div class="hud-panel p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="badge-outline">Auto Parts Wholesale (B2B)</span>
              <span class="live-badge"><span class="live-dot"></span> $1.8M Pipeline</span>
            </div>
            <h3 class="text-lg font-bold mb-3" style="color: var(--color-text-primary);">
              B2B Auto Parts &amp; OEM Wholesale Distributor (SEJ)
            </h3>
            <p class="text-xs leading-relaxed mb-6" style="color: var(--color-text-secondary);">
              Re-engineered faceted catalog architecture, eliminated 120k duplicate crawl bottlenecks, and generated a verified $1.8M B2B wholesale RFQ pipeline.
            </p>
            <div class="grid grid-cols-3 gap-2 p-3 rounded-xl mb-6 text-center" style="background: var(--color-bg-surface);">
              <div>
                <div class="text-xl font-black" style="color: var(--color-gold);">$1.8M</div>
                <div class="text-[10px] font-semibold" style="color: var(--color-text-muted);">Pipeline</div>
              </div>
              <div>
                <div class="text-xl font-black" style="color: var(--color-gold);">+350%</div>
                <div class="text-[10px] font-semibold" style="color: var(--color-text-muted);">Wholesale Leads</div>
              </div>
              <div>
                <div class="text-xl font-black" style="color: var(--color-gold);">99.8%</div>
                <div class="text-[10px] font-semibold" style="color: var(--color-text-muted);">SKUs Indexed</div>
              </div>
            </div>
          </div>
          <a href="/case-studies/sejautoparts/" class="text-xs font-bold text-gradient-gold flex items-center gap-1.5 hover:underline">
            Read B2B Wholesale Case Study →
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- ============================================ -->
  <!-- VISUAL SERP ANATOMY (CITELX-INSPIRED) -->
  <!-- ============================================ -->
  <section class="py-16 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AutomotiveSerpAnatomy
        title="One Query. Five Places to Win, Only One is a Blue Link."
        subtitle="This is a real automotive search result in 2026. Every tier is an owned placement, and legacy blue links now sit at the bottom."
      />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- THE 6-STAGE BUYER JOURNEY FLOW -->
  <!-- ============================================ -->
  <section class="py-16 relative" style="background: var(--color-bg-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AutomotiveBuyerJourneyFlow
        title="The Omnichannel Automotive Buyer Search Journey"
        subtitle="Under-45 car buyers don't just use Google search. They cross-reference across TikTok, YouTube, Gemini, and Google Maps."
      />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- INTERACTIVE LOCAL GEO-GRID SEARCH RADAR -->
  <!-- ============================================ -->
  <section class="py-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="eeat-badge mb-2">Local Proximity Conquest</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold" style="color: var(--color-text-primary);">
          Local Google Maps <span class="text-gradient-gold">5x5 Geo-Grid Simulator</span>
        </h2>
        <p class="text-sm sm:text-base mt-2" style="color: var(--color-text-secondary);">
          See how our multi-department Google Business Profile architecture and citation velocity expand your #1 rank radius across competitive metro zones.
        </p>
      </div>

      <GeoGridSimulator client:visible />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- CONCRETE DELIVERABLES MATRIX (CITELX-INSPIRED) -->
  <!-- ============================================ -->
  <section class="py-16 relative" style="background: var(--color-bg-elevated);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <AutomotiveDeliverablesMatrix
        title="Real Engineering Deliverables, Not Adjectives"
        subtitle="Everything is built on confirmed inventory data, real technician specs, and machine-readable Schema.org vocabularies."
      />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- AUTOMOTIVE ARCHITECTURE & SCHEMA HUDS -->
  <!-- ============================================ -->
  <section class="py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center max-w-3xl mx-auto mb-14">

---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';

const title = "SEO for Automotive — Specialist Automotive Search & SEO Company";
const description = "The specialist automotive SEO company. We help car dealerships, auto repair shops, parts stores, and automotive businesses dominate organic search, local search, and AI-powered search engines.";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SEO for Automotive",
  "url": "https://seoforautomotive.com",
  "description": description,
  "knowsAbout": [
    "Automotive SEO", "Car Dealership SEO", "Auto Repair SEO", "Auto Parts SEO",
    "Local SEO for Automotive", "Technical SEO for Automotive", "eCommerce SEO for Automotive",
    "Answer Engine Optimization", "Generative Engine Optimization", "Automotive Structured Data",
    "E-E-A-T", "Semantic SEO"
  ]
};

const industries = [
  { title: 'Car Dealerships', href: '/industries/car-dealership-seo/', desc: 'Inventory SEO, VDP optimization, make/model/year architecture, local visibility, and dealer reputation management.', icon: '🚗' },
  { title: 'Auto Repair Shops', href: '/industries/auto-repair-seo/', desc: 'Service-area SEO, Google Maps ranking, review management, and mobile-first optimization for mechanics.', icon: '🔧' },
  { title: 'Auto Parts Stores', href: '/industries/auto-parts-seo/', desc: 'Product SEO, category architecture, part number optimization, and compatibility-based search.', icon: '🔩' },
  { title: 'Auto Body & Collision', href: '/industries/auto-body-seo/', desc: 'Local trust signals, insurance-related search, before/after content, and collision repair visibility.', icon: '🛡️' },
  { title: 'Auto Detailing & PPF', href: '/industries/auto-detailing-seo/', desc: 'Ceramic coating and PPF keywords, visual content SEO, and mobile booking conversion.', icon: '✨' },
  { title: 'Car Wash', href: '/industries/car-wash-seo/', desc: 'Multi-location local SEO, membership conversion, Maps 3-Pack targeting, and seasonal demand.', icon: '🧽' },
];

const services = [
  { title: 'Local SEO', href: '/services/automotive-local-seo/', desc: 'Google Business Profile, Maps 3-Pack, local citations, and "near me" targeting.', icon: '📍' },
  { title: 'Technical SEO', href: '/services/automotive-technical-seo/', desc: 'Crawlability, indexation, Core Web Vitals, inventory rendering, and structured data.', icon: '🔧' },
  { title: 'eCommerce SEO', href: '/services/automotive-ecommerce-seo/', desc: 'Product pages, categories, part numbers, faceted navigation, and merchant visibility.', icon: '🛒' },
  { title: 'Content SEO', href: '/services/automotive-content-seo/', desc: 'Topical authority, content clusters, editorial strategy, and information gain.', icon: '📝' },
  { title: 'AEO', href: '/services/automotive-aeo/', desc: 'Featured snippets, People Also Ask, AI Overviews, and voice search optimization.', icon: '💬' },
  { title: 'GEO / AI Search', href: '/services/automotive-geo/', desc: 'ChatGPT, Gemini, Perplexity — getting your brand cited by AI assistants.', icon: '🤖' },
];

const problems = [
  { problem: 'Vehicle pages aren\'t being indexed', context: 'Dynamic inventory systems often create crawlability issues — thousands of VDPs that Google never discovers or drops from the index.' },
  { problem: 'Local competitors outrank you in Maps', context: 'Google Business Profile optimization, NAP consistency, review velocity, and local entity signals directly determine Maps 3-Pack ranking.' },
  { problem: 'Parts pages don\'t rank for product searches', context: 'Auto parts eCommerce requires part-number SEO, compatibility architecture, faceted navigation strategy, and proper product schema.' },
  { problem: 'AI search engines don\'t mention your brand', context: 'ChatGPT, Gemini, and Perplexity pull from authoritative, well-structured sources — most automotive businesses aren\'t optimized for AI citation.' },
];

const caseStudies = [
  {
    title: 'VinylFrog — AEO, Reputation & AI Overview Dominance',
    industry: 'PPF & Vinyl Wraps (B2C)',
    href: '/case-studies/vinylfrog/',
    description: 'VinylFrog partnered with us to dominate answer engines, capture 45+ AI Overview citations, and build an unshakeable 4.9-star online reputation.',
    metrics: [
      { value: '+380%', label: 'Organic Traffic' },
      { value: '45+', label: 'AI Overview Citations' },
      { value: '+290%', label: 'Qualified Leads' },
    ],
    tags: ['AEO', 'AI Overview'],
  },
  {
    title: 'TeckWrap — SEO, AI Overview & Lead Generation',
    industry: 'Vinyl Wraps (B2C)',
    href: '/case-studies/teckwrap/',
    description: 'TeckWrap needed to break through in organic search, capture AI-powered search citations, and convert traffic into dealer and wholesale leads.',
    metrics: [
      { value: '+420%', label: 'Organic Traffic' },
      { value: '+310%', label: 'Lead Generation' },
      { value: '60+', label: 'Featured Snippets' },
    ],
    tags: ['SEO', 'Leads'],
  },
  {
    title: 'SEJ Auto Parts — B2B SEO & Technical Authority',
    industry: 'Auto Parts (B2B)',
    href: '/case-studies/sejautoparts/',
    description: 'SEJ Auto Parts needed technical authority, commercial keyword rankings, and qualified wholesale leads from organic search.',
    metrics: [
      { value: '+350%', label: 'B2B Leads' },
      { value: '$1.8M', label: 'Pipeline Value' },
      { value: '+280%', label: 'Organic Traffic' },
    ],
    tags: ['B2B', 'Technical'],
  },
];

const faqs = [
  {
    question: 'What is automotive SEO?',
    answer: 'Automotive SEO is the practice of optimizing websites for car dealerships, auto repair shops, auto parts stores, and other automotive businesses to rank higher in search engine results. It encompasses <a href="/services/automotive-local-seo/">local SEO</a>, <a href="/services/automotive-technical-seo/">technical optimization</a>, content strategy, <a href="/blog/semantic-seo-entities/">semantic SEO</a>, and structured data — tailored specifically to the unique challenges of the automotive industry such as inventory management, make/model/year architecture, and multi-location search.'
  },
  {
    question: 'How is automotive SEO different from general SEO?',
    answer: 'Automotive businesses face unique search challenges that general SEO doesn\'t address: dynamic vehicle inventory indexation, Vehicle Detail Page (VDP) optimization, make/model/year entity relationships, <a href="/industries/auto-parts-seo/">part number and compatibility search</a>, multi-location dealer group management, and automotive-specific schema types (Vehicle, AutoDealer, AutoRepair). A specialist understands these structural differences.'
  },
  {
    question: 'How much does automotive SEO cost?',
    answer: 'Automotive SEO services typically range from $1,500 to $10,000+ per month depending on the scope, competition level, and number of locations. Single-location repair shops start at the lower end, while multi-location dealer groups require enterprise-level investment. See our <a href="/services/">services page</a> for detailed information.'
  },
  {
    question: 'What is AEO and GEO for automotive businesses?',
    answer: '<strong>AEO (Answer Engine Optimization)</strong> focuses on getting your content featured in Google\'s answer boxes, People Also Ask results, and AI Overviews. <strong>GEO (Generative Engine Optimization)</strong> focuses on getting your brand cited by AI assistants like ChatGPT, Gemini, and Perplexity. Both are increasingly important for automotive businesses. Learn more about <a href="/services/automotive-aeo/">AEO</a> and <a href="/services/automotive-geo/">GEO</a>.'
  },
  {
    question: 'Why is local SEO important for automotive businesses?',
    answer: 'Over 76% of people who search for an automotive business on their phone visit one within a day. <a href="/services/automotive-local-seo/">Automotive local SEO</a> ensures your business appears in the Google Maps 3-Pack, has optimized Google Business Profile listings, maintains NAP consistency across directories, and ranks for high-intent "near me" searches. For dealerships, repair shops, and service businesses, local SEO often delivers the highest ROI of any search channel.'
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/" schemaData={schemaData} noContainer={true}>

  <!-- ================================ -->
  <!-- HERO -->
  <!-- ================================ -->
  <section class="hero-glow relative overflow-hidden">
    <div class="container-main pt-20 pb-24 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Specialization badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full mb-7 animate-fadeIn" style="background: var(--color-gold-muted); border: 1px solid var(--color-gold-border);">
          <span class="w-1.5 h-1.5 rounded-full animate-pulse-subtle" style="background: var(--color-gold);" aria-hidden="true"></span>
          <span class="text-xs font-semibold tracking-wide" style="color: var(--color-gold);">Specialist Automotive SEO Company</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight leading-[1.1] animate-slideUp" style="color: var(--color-text-primary);">
          Automotive search,<br />
          <span class="text-gradient-gold">engineered.</span>
        </h1>

        <p class="mt-6 text-lg max-w-2xl mx-auto leading-relaxed animate-slideUp" style="animation-delay: 80ms; color: var(--color-text-secondary);">
          We help <a href="/industries/car-dealership-seo/" style="color: var(--color-gold); text-decoration: underline; text-underline-offset: 2px;">car dealerships</a>,
          <a href="/industries/auto-repair-seo/" style="color: var(--color-gold); text-decoration: underline; text-underline-offset: 2px;">auto repair shops</a>,
          <a href="/industries/auto-parts-seo/" style="color: var(--color-gold); text-decoration: underline; text-underline-offset: 2px;">parts stores</a>,
          and automotive businesses dominate organic search, local search, and AI-powered search engines.
        </p>

        <!-- CTAs -->
        <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3 animate-slideUp" style="animation-delay: 150ms;">
          <a href="/contact/" class="btn-primary" id="hero-cta-primary">
            Request a Strategy Call
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
          <a href="/audit/" class="btn-gold" id="hero-cta-audit">
            Free SEO Audit
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.746 3.746 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
          </a>
        </div>

        <!-- Trust bar -->
        <div class="mt-12 flex flex-wrap items-center justify-center gap-6 animate-fadeIn" style="animation-delay: 250ms;">
          <span class="text-xs font-medium tracking-wide uppercase" style="color: var(--color-text-muted);">Data-Driven with:</span>
          <span class="text-sm font-semibold" style="color: var(--color-text-secondary);">Google Search Console</span>
          <span style="color: var(--color-border-strong);">·</span>
          <span class="text-sm font-semibold" style="color: var(--color-text-secondary);">Google Analytics 4</span>
          <span style="color: var(--color-border-strong);">·</span>
          <span class="text-sm font-semibold" style="color: var(--color-text-secondary);">SEMrush</span>
          <span style="color: var(--color-border-strong);">·</span>
          <span class="text-sm font-semibold" style="color: var(--color-text-secondary);">Ahrefs</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================ -->
  <!-- SOCIAL PROOF STATS -->
  <!-- ================================ -->
  <section class="section-border">
    <div class="container-main py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="stat-card">
          <div class="metric-value">50+</div>
          <div class="metric-label">Automotive Clients</div>
        </div>
        <div class="stat-card">
          <div class="metric-value">340%</div>
          <div class="metric-label">Avg. Traffic Growth</div>
        </div>
        <div class="stat-card">
          <div class="metric-value">6</div>
          <div class="metric-label">Industry Verticals</div>
        </div>
        <div class="stat-card">
          <div class="metric-value">100%</div>
          <div class="metric-label">Automotive Focus</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================ -->
  <!-- WHY AUTOMOTIVE SEO IS DIFFERENT -->
  <!-- ================================ -->
  <section class="container-main section-spacing" id="problems">
    <div class="text-center mb-12 max-w-2xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold" style="color: var(--color-text-primary);">
        Why automotive search is structurally different
      </h2>
      <p class="mt-3" style="color: var(--color-text-secondary);">
        General SEO agencies don't understand the structural challenges unique to automotive businesses.
        We do — because automotive search is all we do.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
      {problems.map((item) => (
        <div class="glass-card rounded-lg p-5">
          <div class="flex items-start gap-3">
            <span class="w-7 h-7 rounded-md flex items-center justify-center text-sm font-bold shrink-0 mt-0.5" style="background: rgba(220, 38, 38, 0.08); color: #dc2626;" aria-hidden="true">!</span>
            <div>
              <h3 class="text-sm font-semibold mb-1.5" style="color: var(--color-text-primary);">{item.problem}</h3>
              <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">{item.context}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ================================ -->
  <!-- INDUSTRIES WE SERVE -->
  <!-- ================================ -->
  <section class="container-main section-spacing section-border" id="industries">
    <div class="mb-10">
      <span class="badge-outline mb-3">Industry Expertise</span>
      <h2 class="text-2xl sm:text-3xl font-bold mt-2" style="color: var(--color-text-primary);">
        Built for every automotive vertical
      </h2>
      <p class="mt-3 max-w-2xl" style="color: var(--color-text-secondary);">
        We understand the search architecture, customer journey, and technical challenges specific to each automotive business type.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {industries.map(ind => (
        <a href={ind.href} class="service-card group" id={`ind-${ind.href.split('/').filter(Boolean).pop()}`}>
          <span class="text-2xl mb-3 block" aria-hidden="true">{ind.icon}</span>
          <h3 class="text-base font-bold transition-colors mb-2" style="color: var(--color-text-primary);">{ind.title}</h3>
          <p class="text-xs leading-relaxed mb-3" style="color: var(--color-text-muted);">{ind.desc}</p>
          <span class="btn-ghost text-xs p-0">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ================================ -->
  <!-- CORE SERVICES -->
  <!-- ================================ -->
  <section class="container-main section-spacing section-border" id="services">
    <div class="mb-10">
      <span class="badge-outline mb-3">SEO Services</span>
      <h2 class="text-2xl sm:text-3xl font-bold mt-2" style="color: var(--color-text-primary);">
        Automotive SEO services
      </h2>
      <p class="mt-3 max-w-2xl" style="color: var(--color-text-secondary);">
        From <a href="/services/automotive-local-seo/" style="color: var(--color-gold);">local search</a> to
        <a href="/services/automotive-geo/" style="color: var(--color-gold);">AI-powered search engines</a> —
        every service is designed specifically for automotive businesses.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {services.map(svc => (
        <a href={svc.href} class="glass-card rounded-lg p-5 group block">
          <span class="text-2xl mb-3 block" aria-hidden="true">{svc.icon}</span>
          <h3 class="text-sm font-bold transition-colors mb-2" style="color: var(--color-text-primary);">{svc.title}</h3>
          <p class="text-xs leading-relaxed" style="color: var(--color-text-muted);">{svc.desc}</p>
        </a>
      ))}
    </div>

    <div class="mt-6 text-center">
      <a href="/services/" class="btn-secondary">View All Services & Pricing →</a>
    </div>
  </section>

  <!-- ================================ -->
  <!-- CASE STUDIES PREVIEW -->
  <!-- ================================ -->
  <section class="container-main section-spacing section-border" id="case-studies">
    <div class="mb-10">
      <span class="badge-outline mb-3">Proven Results</span>
      <h2 class="text-2xl sm:text-3xl font-bold mt-2" style="color: var(--color-text-primary);">
        Case studies & results
      </h2>
      <p class="mt-3 max-w-2xl" style="color: var(--color-text-secondary);">
        Real automotive businesses. Real search results. Measured with
        Google Search Console, GA4, and SEMrush.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      {caseStudies.map(cs => (
        <CaseStudyCard
          title={cs.title}
          industry={cs.industry}
          href={cs.href}
          metrics={cs.metrics}
          description={cs.description}
          tags={cs.tags}
        />
      ))}
    </div>

    <div class="mt-6 text-center">
      <a href="/case-studies/" class="btn-secondary">View All Case Studies →</a>
    </div>
  </section>

  <!-- ================================ -->
  <!-- METHODOLOGY — How we think -->
  <!-- ================================ -->
  <section class="container-main section-spacing section-border" id="methodology">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <span class="badge-outline mb-3">Our Approach</span>
        <h2 class="text-2xl font-bold mt-2 mb-5" style="color: var(--color-text-primary);">How automotive SEO actually works</h2>
        <div class="prose-content">
          <p>Most SEO agencies apply generic strategies to automotive businesses and wonder why vehicle pages don't rank. Automotive search requires understanding the structural relationships between <strong>inventory, locations, services, and entities</strong> that define how search engines model the automotive industry.</p>

          <h3>Entity-first architecture</h3>
          <p>We build <a href="/blog/semantic-seo-entities/">semantic relationships</a> between automotive entities — makes, models, service types, locations, and business categories — rather than chasing individual keywords.</p>

          <h3>Automotive-specific technical SEO</h3>
          <p>Vehicle inventory creates unique <a href="/services/automotive-technical-seo/">technical challenges</a>: dynamic page generation, duplicate URL management, faceted navigation, JavaScript rendering of VDP content, and proper canonical handling.</p>

          <h3>Beyond traditional search</h3>
          <p>We optimize for where automotive search is going — <a href="/services/automotive-aeo/">answer engines</a>, <a href="/services/automotive-geo/">AI assistants</a>, and large language models that increasingly influence how consumers find automotive businesses.</p>
        </div>
      </div>

      <div class="space-y-3">
        <div class="glass-card rounded-lg p-4">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-md flex items-center justify-center font-bold text-xs" style="background: var(--color-gold-muted); color: var(--color-gold);">1</span>
            <h3 class="text-sm font-bold" style="color: var(--color-text-primary);">Automotive Audit</h3>
          </div>
          <p class="text-xs ml-10" style="color: var(--color-text-muted);">Technical, content, semantic, entity, and local SEO analysis built specifically for automotive website architectures.</p>
        </div>
        <div class="glass-card rounded-lg p-4">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-md flex items-center justify-center font-bold text-xs" style="background: var(--color-gold-muted); color: var(--color-gold);">2</span>
            <h3 class="text-sm font-bold" style="color: var(--color-text-primary);">Search Architecture</h3>
          </div>
          <p class="text-xs ml-10" style="color: var(--color-text-muted);">Entity mapping, topical authority design, internal linking architecture, and structured data implementation.</p>
        </div>
        <div class="glass-card rounded-lg p-4">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-md flex items-center justify-center font-bold text-xs" style="background: var(--color-secondary-muted); color: var(--color-secondary);">3</span>
            <h3 class="text-sm font-bold" style="color: var(--color-text-primary);">Content & Authority</h3>
          </div>
          <p class="text-xs ml-10" style="color: var(--color-text-muted);">Topic clusters, <a href="/blog/eeat-automotive-seo/" style="color: var(--color-gold);">E-E-A-T</a> signals, expertise demonstration, and strategic content that builds topical authority.</p>
        </div>
        <div class="glass-card rounded-lg p-4">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-7 h-7 rounded-md flex items-center justify-center font-bold text-xs" style="background: var(--color-secondary-muted); color: var(--color-secondary);">4</span>
            <h3 class="text-sm font-bold" style="color: var(--color-text-primary);">Measurement & Growth</h3>
          </div>
          <p class="text-xs ml-10" style="color: var(--color-text-muted);">Organic traffic, qualified leads, local visibility, AI citations, and revenue attribution — not just rankings.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================ -->
  <!-- FREE AUDIT CTA -->
  <!-- ================================ -->
  <section class="container-main section-spacing section-border">
    <div class="glass-panel rounded-xl p-8 sm:p-12 text-center max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold mb-3" style="color: var(--color-text-primary);">
        Get your free automotive SEO audit
      </h2>
      <p class="mb-7 max-w-lg mx-auto" style="color: var(--color-text-secondary);">
        Enter your website URL and get an instant analysis of your technical SEO, local SEO, AEO & GEO readiness, CRO signals, and more — built specifically for automotive websites.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/audit/" class="btn-gold" id="cta-audit">
          Run Free Audit Now
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.746 3.746 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
        </a>
        <a href="/contact/" class="btn-secondary" id="cta-contact">
          Request a Strategy Call
        </a>
      </div>
    </div>
  </section>

  <!-- ================================ -->
  <!-- CTA — Final conversion -->
  <!-- ================================ -->
  <section class="container-main section-spacing section-border">
    <div class="glass-panel rounded-xl p-8 sm:p-12 text-center max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold mb-3" style="color: var(--color-text-primary);">
        Ready to dominate automotive search?
      </h2>
      <p class="mb-7 max-w-lg mx-auto" style="color: var(--color-text-secondary);">
        Whether you're a single-location repair shop or a multi-state dealer group —
        let's build a search strategy designed for your automotive business.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/contact/" class="btn-primary" id="footer-cta-primary">
          Request a Strategy Call

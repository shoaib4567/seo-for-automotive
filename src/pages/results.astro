---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Results & Case Studies — Automotive SEO Performance | SEO for Automotive";
const description = "Automotive SEO case studies and results. See how our specialist SEO strategies drive organic traffic, leads, AI Overview citations, and revenue for VinylFrog, TeckWrap, SEJ Auto Parts, and BigACover.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Results', href: '/results/' },
];

// Redirect to /case-studies/ — keep this page for SEO value of existing links
---

<BaseLayout title={title} description={description} canonicalPath="/case-studies/" breadcrumbs={breadcrumbs}>

  <div class="max-w-3xl">
    <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight mb-6" style="color: var(--color-text-primary);">
      Results & <span class="text-gradient-gold">Case Studies</span>
    </h1>

    <div class="prose-content">
      <p class="text-lg" style="color: var(--color-text-secondary);">We've moved our results and case studies to a dedicated section. View our detailed case studies with real client data below:</p>
    </div>

    <!-- Case study links -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
      <a href="/case-studies/vinylfrog/" class="service-card group">
        <span class="badge-outline mb-2">PPF & Vinyl Wraps (B2C)</span>
        <h3 class="text-sm font-bold mb-1" style="color: var(--color-text-primary);">VinylFrog — AEO & AI Overview</h3>
        <p class="text-xs" style="color: var(--color-text-muted);">+380% traffic, 45+ AI Overview citations</p>
      </a>
      <a href="/case-studies/teckwrap/" class="service-card group">
        <span class="badge-outline mb-2">Vinyl Wraps (B2C)</span>
        <h3 class="text-sm font-bold mb-1" style="color: var(--color-text-primary);">TeckWrap — SEO & Lead Gen</h3>
        <p class="text-xs" style="color: var(--color-text-muted);">+420% traffic, +310% leads</p>
      </a>
      <a href="/case-studies/sejautoparts/" class="service-card group">
        <span class="badge-outline mb-2">Auto Parts (B2B)</span>
        <h3 class="text-sm font-bold mb-1" style="color: var(--color-text-primary);">SEJ Auto Parts — B2B SEO</h3>
        <p class="text-xs" style="color: var(--color-text-muted);">+350% B2B leads, $1.8M pipeline</p>
      </a>
      <a href="/case-studies/bigacover/" class="service-card group">
        <span class="badge-outline mb-2">Car Covers (B2C)</span>
        <h3 class="text-sm font-bold mb-1" style="color: var(--color-text-primary);">BigACover — eCommerce Growth</h3>
        <p class="text-xs" style="color: var(--color-text-muted);">+460% organic revenue, 4.8★ rating</p>
      </a>
    </div>

    <div class="mt-8 text-center">
      <a href="/case-studies/" class="btn-primary">View All Case Studies →</a>
    </div>
  </div>

</BaseLayout>

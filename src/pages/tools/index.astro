---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Automotive SEO Tools — Free Schema Generator, Auditors & Calculators";
const description = "Free automotive SEO tools: Vehicle Schema Generator, VDP Auditor, Local SEO Optimizer, ROI Calculator, and Competitor Analyzer. Built for dealerships, repair shops, and parts stores.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tools', href: '/tools/' },
];

const tools = [
  {
    title: 'Automotive Schema Generator',
    href: '/tools/automotive-schema-generator/',
    desc: 'Generate Schema.org JSON-LD structured data for Vehicle, AutoDealer, and AutoRepair entities. Copy-paste ready for your website.',
    icon: '🏗️',
    badge: 'Most Popular',
  },
  {
    title: 'VDP Auditor',
    href: '/tools/vdp-auditor/',
    desc: 'Audit Vehicle Detail Pages for SEO best practices — title tags, schema, indexability, content quality, and conversion elements.',
    icon: '🔍',
    badge: 'Dealerships',
  },
  {
    title: 'Local SEO Optimizer',
    href: '/tools/local-seo-optimizer/',
    desc: 'Analyze Google Maps 3-Pack performance, GBP health, NAP consistency, and review management for automotive businesses.',
    icon: '📍',
    badge: 'Local',
  },
  {
    title: 'SEO ROI Calculator',
    href: '/tools/seo-roi-calculator/',
    desc: 'Model the revenue impact of automotive SEO — traffic, leads, sales, and return on investment for dealerships.',
    icon: '📊',
    badge: 'Dealerships',
  },
  {
    title: 'Competitor Analyzer',
    href: '/tools/competitor-analyzer/',
    desc: 'Compare your automotive SEO performance against competitors across local visibility, schema, page speed, and authority.',
    icon: '⚔️',
    badge: 'Analysis',
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/tools/" breadcrumbs={breadcrumbs}>

  <div class="mb-12">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white leading-tight">
      Automotive SEO <span class="text-gradient-gold">Tools</span>
    </h1>
    <p class="mt-4 text-lg text-slate-400 max-w-3xl leading-relaxed">
      Purpose-built tools for automotive search optimization. Each tool addresses a specific challenge that automotive businesses face — from <a href="/knowledge/automotive-schema-guide/" class="text-[#d4a853] hover:underline">structured data generation</a> to <a href="/services/automotive-local-seo/" class="text-[#d4a853] hover:underline">local SEO analysis</a>.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {tools.map(tool => (
      <a href={tool.href} class="service-card group" id={`tool-${tool.href.split('/').filter(Boolean).pop()}`}>
        <div class="flex items-start justify-between mb-3">
          <span class="text-2xl" aria-hidden="true">{tool.icon}</span>
          <span class="kw-badge text-[10px]">{tool.badge}</span>
        </div>
        <h2 class="text-base font-bold text-slate-200 group-hover:text-[#d4a853] transition-colors mb-2">{tool.title}</h2>
        <p class="text-sm text-slate-500 leading-relaxed">{tool.desc}</p>
      </a>
    ))}
  </div>

  <div class="mt-12 section-border pt-10">
    <div class="prose-content">
      <h2>Why we build automotive SEO tools</h2>
      <p>These tools aren't gimmicks — they solve actual problems that automotive businesses encounter daily. Each tool demonstrates our methodology and provides genuine utility:</p>
      <ul>
        <li><strong>Schema Generator</strong> — proper <a href="/knowledge/automotive-schema-guide/">structured data</a> is critical for Vehicle Listings, rich snippets, and Knowledge Graph presence. Most dealership websites either lack schema entirely or implement it incorrectly.</li>
        <li><strong>VDP Auditor</strong> — Vehicle Detail Pages are the primary conversion pages for dealerships. Our audit methodology evaluates the 12 factors that determine whether a VDP ranks and converts.</li>
        <li><strong>Local SEO Optimizer</strong> — <a href="/services/automotive-local-seo/">local search</a> drives the majority of leads for automotive service businesses. This tool illustrates the competitive analysis we perform for every engagement.</li>
        <li><strong>ROI Calculator</strong> — automotive business owners need to understand the financial model behind SEO investment before committing. This calculator models realistic dealership economics.</li>
      </ul>
      <p>Tools serve multiple strategic purposes — they provide genuine value, demonstrate expertise, support <a href="/knowledge/eeat-automotive-seo/">E-E-A-T signals</a>, and create linkable assets that strengthen domain authority.</p>
    </div>
  </div>

</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import InternalLinkCard from '../components/InternalLinkCard.astro';
import FaqSection from '../components/FaqSection.astro';
import AuthorCard from '../components/AuthorCard.astro';
import AutomotiveRoiCalculator from '../components/interactive/AutomotiveRoiCalculator.jsx';
import GeoGridSimulator from '../components/interactive/GeoGridSimulator.jsx';
import ExecutionRoadmapTabs from '../components/interactive/ExecutionRoadmapTabs.jsx';
import InteractiveSchemaSnippet from '../components/interactive/InteractiveSchemaSnippet.jsx';
import AutomotiveArchitectureDiagram from '../components/visuals/AutomotiveArchitectureDiagram.astro';

const title = "Auto Repair SEO Services — SEO for Mechanics & Repair Shops [2026 Strategy]";
const description = "Specialized SEO for independent auto repair shops, mechanics, transmission specialists, and tire centers. Dominate Google Maps 3-Pack, capture high-ticket repair jobs, and fill service bays.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Auto Repair SEO', href: '/auto-repair-seo-services/' },
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Auto Repair SEO Services",
  "description": description,
  "provider": { "@type": "Organization", "name": "SEO for Automotive", "url": "https://seoforautomotive.com" },
  "serviceType": "Search Engine Optimization for Auto Repair Shops",
  "areaServed": "United States"
};

const spokeLinks = [
  { title: 'Auto Body & Collision SEO', href: '/seo-for-auto-body-shops/', description: 'SEO for auto body shops and collision repair centers.', icon: '🛡️', volume: '560/mo' },
  { title: 'Auto Parts SEO', href: '/auto-parts-seo-services/', description: 'E-commerce SEO for auto parts stores and suppliers.', icon: '🔩', volume: '1,300/mo' },
  { title: 'Auto Detailing SEO', href: '/auto-detailing-seo-services/', description: 'SEO for car detailing businesses and mobile detailers.', icon: '✨', volume: '1,570/mo' },
  { title: 'Car Wash SEO', href: '/seo-for-car-wash/', description: 'SEO for car wash and detailing shops.', icon: '🧽', volume: '750/mo' },
  { title: 'Local SEO for Repair Shops', href: '/services/automotive-local-seo/', description: 'Google Maps 3-Pack & local citation strategies.', icon: '📍', volume: '3,180/mo' },
  { title: 'Reputation Management', href: '/automotive-reputation-management-services/', description: 'Automated 5-star review generation for mechanics.', icon: '⭐', volume: '2,720/mo' },
];

const faqs = [
  { question: 'How can auto repair shops get more high-ticket repair jobs through SEO?', answer: 'Rather than targeting generic "oil change" queries, we engineer service landing pages for high-ticket repair orders: transmission overhauls, engine head gasket diagnostics, brake rotor replacements, European car repair (BMW/Mercedes/Audi), and A/C compressor service. These convert at high margins with an Average Repair Order of $650–$1,800.' },
  { question: 'What is the fastest way to rank in the Google Maps 3-Pack for mechanic searches?', answer: 'Completing full GBP primary and secondary categories, embedding localized <code>AutoRepair</code> JSON-LD schema on your website, building consistent NAP citations across 50+ auto directories, and deploying an automated post-service SMS review request system.' },
  { question: 'Do you provide SEO for mobile mechanics and fleet service providers?', answer: 'Yes. Mobile mechanics require Service Area Page (SAP) architecture across targeted city polygons, while commercial fleet mechanics target B2B diesel and preventative maintenance procurement keywords.' },
];
---

<BaseLayout title={title} description={description} canonicalPath="/auto-repair-seo-services/" breadcrumbs={breadcrumbs} schemaData={schemaData}>

  <!-- Hero Header -->
  <div class="mb-14">
    <div class="flex items-center gap-3 mb-4">
      <span class="badge-outline">Shop Search Engineering</span>
      <span class="eeat-badge">High-Ticket Repair Bays</span>
      <span class="live-badge"><span class="live-dot"></span> 8,210/mo Search Demand</span>
    </div>
    
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight" style="color: var(--color-text-primary);">
      Auto Repair <span class="text-gradient-gold">SEO Services</span>
    </h1>
    
    <p class="mt-4 text-lg text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
      Comprehensive search optimization engineered for independent auto repair shops, master mechanics, and specialty transmission/brake centers. We dominate the Google Maps 3-Pack within a 15-mile radius and capture urgent, high-margin repair orders to keep your bays operating at peak capacity.
    </p>
  </div>

  <!-- Key Metrics Telemetry -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
    <div class="hud-panel p-5 text-center">
      <div class="text-3xl font-black" style="color: var(--color-gold);">+540%</div>
      <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Inbound Phone Inquiries</div>
    </div>
    <div class="hud-panel p-5 text-center">
      <div class="text-3xl font-black" style="color: var(--color-gold);">#1</div>
      <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Maps 3-Pack Placement</div>
    </div>
    <div class="hud-panel p-5 text-center">
      <div class="text-3xl font-black" style="color: var(--color-gold);">$850+</div>
      <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Average Repair Order (ARO)</div>
    </div>
    <div class="hud-panel p-5 text-center">
      <div class="text-3xl font-black" style="color: var(--color-gold);">4.9★</div>
      <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Review Reputation Score</div>
    </div>
  </div>

  <!-- Interactive ROI Simulator -->
  <div class="my-16">
    <AutomotiveRoiCalculator client:load defaultType="repair" />
  </div>

  <!-- Emergency vs Scheduled Repair Funnel Schematic -->
  <div class="my-14">
    <AutomotiveArchitectureDiagram
      type="emergency-funnel"
      title="High-Ticket Emergency & Diagnostic Search Funnel"
      subtitle="How our mobile-first local architecture captures stranded drivers and high-margin transmission/brake repairs."
    />
  </div>

  <!-- Interactive GeoGrid Simulator -->
  <div class="my-16">
    <GeoGridSimulator client:visible />
  </div>

  <!-- AutoRepair Schema Inspector -->
  <div class="my-16">
    <InteractiveSchemaSnippet client:visible />
  </div>

  <!-- Execution Roadmap Blueprint -->
  <div class="my-16">
    <ExecutionRoadmapTabs client:visible />
  </div>

  <!-- Top Keywords Table -->
  <div class="prose-content mt-14 mb-6">
    <h2>High-Volume Auto Repair Search Queries</h2>
  </div>

  <div class="overflow-x-auto mb-14">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-white/[0.08] text-left">
          <th class="pb-3 text-slate-600 dark:text-slate-400 font-semibold">Keyword Target</th>
          <th class="pb-3 text-slate-600 dark:text-slate-400 font-semibold text-right">Monthly Volume</th>
          <th class="pb-3 text-slate-600 dark:text-slate-400 font-semibold text-right">Intent Profile</th>
        </tr>
      </thead>
      <tbody class="text-slate-700 dark:text-slate-300">
        <tr class="border-b border-white/[0.04]"><td class="py-2.5 font-medium text-amber-400">auto repair seo</td><td class="text-right">880/mo</td><td class="text-right text-emerald-400 font-mono">Commercial</td></tr>
        <tr class="border-b border-white/[0.04]"><td class="py-2.5">[city] mechanic near me</td><td class="text-right">18,200/mo (aggregate)</td><td class="text-right text-emerald-400 font-mono">Emergency / Local</td></tr>
        <tr class="border-b border-white/[0.04]"><td class="py-2.5">brake repair shop near me</td><td class="text-right">9,400/mo (aggregate)</td><td class="text-right text-emerald-400 font-mono">High Ticket Service</td></tr>
        <tr class="border-b border-white/[0.04]"><td class="py-2.5">transmission repair [city]</td><td class="text-right">4,100/mo (aggregate)</td><td class="text-right text-emerald-400 font-mono">High Margin ($1,500+)</td></tr>
        <tr class="border-b border-white/[0.04]"><td class="py-2.5">european auto repair [city]</td><td class="text-right">2,800/mo (aggregate)</td><td class="text-right text-cyan-400 font-mono">Specialty Foreign</td></tr>
      </tbody>
    </table>
  </div>

  <!-- Related Spoke Hubs -->
  <div class="mt-12 mb-16">
    <h2 class="text-xl font-bold mb-6" style="color: var(--color-text-primary);">Related Repair Verticals</h2>
    <InternalLinkCard links={spokeLinks} columns={3} />
  </div>

  <!-- Author E-E-A-T -->
  <AuthorCard name="Automotive SEO Team" role="Auto Repair & Service Search Specialists" bio="Our search engineers specialize in local Google Maps 3-Pack dominance and high-ticket service bay acquisition for independent mechanics and franchise service centers." expertise={['Auto Repair Local SEO', 'Google Maps 3-Pack', 'AutoRepair Schema', 'Review Velocity Engines', 'Emergency Search Capture']} />

  <!-- FAQ -->
  <FaqSection items={faqs} title="Auto Repair SEO — Frequently Asked Questions" />

</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';

const title = "Automotive SEO Services — Specialist Search Engineering & Strategy | SEO for Automotive";
const description = "Comprehensive, enterprise-grade automotive SEO services engineered for dealerships, auto repair shops, parts manufacturers, and automotive eCommerce brands. 15+ years domain authority.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Automotive SEO', href: '/services/automotive-seo/' },
];

const capabilities = [
  { title: 'Technical VDP/SRP Architecture', desc: 'Dynamic XML inventory feeds, automated canonical handling, and faceted crawl budget control ensuring 99.8% indexation.', icon: 'wrench' },
  { title: 'Local Google Maps 3-Pack', desc: 'Multi-department GBP structuring (Sales, Service, Parts, Collision) with geo-grid proximity ranking and review velocity SOPs.', icon: 'map' },
  { title: 'AEO & AI Overview Dominance', desc: 'Answer-first entity clusters and Schema.org structured data engineered to capture Google AI Overviews and ChatGPT recommendations.', icon: 'sparkles' },
  { title: 'Auto Parts eCommerce SEO', desc: 'Part number compatibility indexing, OEM cross-referencing, and merchant visibility across Google Shopping and Free Listings.', icon: 'cart' },
  { title: 'Topical Authority & Content', desc: 'Information-gain clusters covering vehicle specs, maintenance intervals, and comparison guides that outrank generic aggregators.', icon: 'document' },
  { title: 'Conversion Rate Optimization (CRO)', desc: 'Streamlined test-drive forms, click-to-call dialers, inventory filters, and CRM lead routing that maximize showroom visits.', icon: 'chart' },
];

const faqs = [
  {
    question: 'How does your automotive SEO service differ from generic digital marketing agencies?',
    answer: 'Generic agencies treat car dealerships and parts manufacturers like ordinary blog websites. They write fluff content that fails to index dynamic vehicle inventory or drive qualified showroom leads. We have 15+ years of dedicated automotive search expertise. We understand VDP/SRP inventory lifecycles, make/model/year entity relationships, OEM part number indexing, and multi-location Google Business Profile hierarchies.'
  },
  {
    question: 'How quickly can an automotive business expect organic ranking and lead improvements?',
    answer: 'Technical SEO fixes and Google Business Profile optimizations typically produce measurable ranking lifts in the Maps 3-Pack within 30 to 45 days. Major organic traffic scaling, topical authority capture, and AI Overview citations compound significantly within 3 to 6 months. Every campaign is tracked in real-time via Google Search Console and GA4.'
  },
  {
    question: 'What automotive schema markup and structured data do you implement?',
    answer: 'We deploy comprehensive nested Schema.org vocabularies including <code>Vehicle</code>, <code>AutoDealer</code>, <code>AutoRepair</code>, <code>AutomotiveBusiness</code>, <code>Product</code> (with <code>mpn</code>, <code>sku</code>, <code>gtin13</code>, and fitment attributes), <code>FAQPage</code>, <code>HowTo</code>, and <code>AggregateRating</code>.'
  },
  {
    question: 'Do you work with B2B automotive parts suppliers as well as B2C dealerships?',
    answer: 'Yes. We engineer search engines for both B2C brands (dealership groups, detailing studios, eCommerce retailers) and B2B enterprises (OEM parts manufacturers, wholesale distributors, commercial fleet suppliers). See our verified B2B parts case study (SEJ) with $1.8M in attributed pipeline.'
  }
];
---

<BaseLayout title={title} description={description} canonicalPath="/services/automotive-seo/" breadcrumbs={breadcrumbs}>
  <div class="max-w-6xl mx-auto">
    
    <!-- Hero Header -->
    <div class="mb-14">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge-outline">Enterprise Service Suite</span>
        <span class="eeat-badge">15+ Years Domain Depth</span>
        <span class="live-badge"><span class="live-dot"></span> Full-Funnel Search Architecture</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black leading-tight mb-6" style="color: var(--color-text-primary);">
        Automotive SEO <span class="text-gradient-gold">Engineered for Category Dominance</span>
      </h1>
      
      <p class="text-lg sm:text-xl leading-relaxed max-w-3xl" style="color: var(--color-text-secondary);">
        The definitive organic search, local Google Maps 3-Pack, and AI Overview engine built exclusively for automotive businesses. We transform high-intent automotive searchers into verified showroom visits, service appointments, and eCommerce transactions.
      </p>
    </div>

    <!-- Telemetry HUD Visual Banner -->
    <div class="relative rounded-2xl overflow-hidden border shadow-2xl mb-16" style="border-color: var(--color-border); background: var(--color-bg-card);">
      <img
        src="/hero-hud.jpg"
        alt="Automotive SEO Search Engineering Telemetry HUD"
        class="w-full h-auto object-cover"
        loading="eager"
      />
      <div class="p-4 border-t flex flex-wrap items-center justify-between gap-3 text-xs" style="border-color: var(--color-border); background: var(--color-bg-surface);">
        <span class="font-bold flex items-center gap-2" style="color: var(--color-text-primary);">
          <span class="live-dot"></span> Proprietary Automotive Entity Vectorization & Crawl Optimization Engine
        </span>
        <span class="text-[11px] font-semibold" style="color: var(--color-gold);">100% Automotive Specialization</span>
      </div>
    </div>

    <!-- Core Metrics Proof Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">+380%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Avg. Traffic Growth</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">99.8%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">VDP Crawl Efficiency</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">#1</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Google Maps 3-Pack Focus</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">45+</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">AI Overview Citations</div>
      </div>
    </div>

    <!-- 6 Pillar Core Capabilities Grid -->
    <div class="mb-20">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="eeat-badge mb-2">Our Methodologies</span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-2" style="color: var(--color-text-primary);">
          Full-Spectrum Automotive Search Capabilities
        </h2>
        <p class="text-sm mt-2" style="color: var(--color-text-secondary);">
          Every element of your automotive search footprint engineered to perform under Google's latest algorithm updates.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {capabilities.map(cap => (
          <div class="hud-panel p-6 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style="background: var(--color-gold-muted); color: var(--color-gold);">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
              </div>
              <h3 class="text-base font-bold mb-2" style="color: var(--color-text-primary);">{cap.title}</h3>
              <p class="text-xs leading-relaxed" style="color: var(--color-text-secondary);">{cap.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 4-Step Automotive Search Execution Framework -->
    <div class="hud-panel p-8 sm:p-12 mb-20">
      <div class="max-w-2xl mb-10">
        <span class="eeat-badge mb-2">Execution Protocol</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold mt-2" style="color: var(--color-text-primary);">
          How We Engineer Automotive Market Leadership
        </h2>
        <p class="text-sm mt-2" style="color: var(--color-text-secondary);">
          A battle-tested 4-phase optimization framework refined over 15+ years of automotive search campaigns.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-4 rounded-xl border" style="background: var(--color-bg-surface); border-color: var(--color-border);">
          <div class="text-xs font-black mb-2" style="color: var(--color-gold);">PHASE 01</div>
          <h4 class="font-bold text-sm mb-2" style="color: var(--color-text-primary);">Deep Automotive Audit</h4>
          <p class="text-xs" style="color: var(--color-text-muted);">VDP indexation diagnostics, inventory churn handling, GBP citation hygiene, and competitive entity gap analysis.</p>
        </div>

        <div class="p-4 rounded-xl border" style="background: var(--color-bg-surface); border-color: var(--color-border);">
          <div class="text-xs font-black mb-2" style="color: var(--color-gold);">PHASE 02</div>
          <h4 class="font-bold text-sm mb-2" style="color: var(--color-text-primary);">Entity & Schema Architecture</h4>
          <p class="text-xs" style="color: var(--color-text-muted);">Deployment of nested Vehicle, AutoDealer, and Part Number schemas; canonical taxonomy restructuring; and Core Web Vitals remediation.</p>
        </div>

        <div class="p-4 rounded-xl border" style="background: var(--color-bg-surface); border-color: var(--color-border);">
          <div class="text-xs font-black mb-2" style="color: var(--color-gold);">PHASE 03</div>
          <h4 class="font-bold text-sm mb-2" style="color: var(--color-text-primary);">AEO & Topical Authority</h4>
          <p class="text-xs" style="color: var(--color-text-muted);">Publishing question-intent specification guides, comparison tables, and local service hubs designed for Google AI Overviews.</p>
        </div>

        <div class="p-4 rounded-xl border" style="background: var(--color-bg-surface); border-color: var(--color-border);">
          <div class="text-xs font-black mb-2" style="color: var(--color-gold);">PHASE 04</div>
          <h4 class="font-bold text-sm mb-2" style="color: var(--color-text-primary);">CRO & Revenue Attribution</h4>
          <p class="text-xs" style="color: var(--color-text-muted);">Phone call attribution, test-drive form conversion rate optimization, and monthly GSC/GA4 executive reporting.</p>
        </div>
      </div>
    </div>

    <!-- Verified Client Case Studies Cross-Links -->
    <div class="mb-20">
      <div class="flex items-center justify-between mb-8">
        <div>
          <span class="eeat-badge mb-1">Proven Results</span>
          <h2 class="text-2xl font-bold" style="color: var(--color-text-primary);">Documented Client Outcomes</h2>
        </div>
        <a href="/case-studies/" class="text-xs font-bold text-gradient-gold hover:underline">View All Case Studies →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/case-studies/vinylfrog/" class="hud-panel p-6 block group">
          <span class="text-[10px] font-bold px-2 py-0.5 rounded" style="background: var(--color-gold-muted); color: var(--color-gold);">B2C Wrap & PPF (VF)</span>
          <h3 class="text-base font-bold my-2 group-hover:text-[var(--color-gold)]" style="color: var(--color-text-primary);">AEO & Google AI Overview #1 Dominance</h3>
          <p class="text-xs" style="color: var(--color-text-muted);">+380% traffic growth, 45+ AI Overview citations, 4.9★ reputation score.</p>
        </a>

        <a href="/case-studies/sejautoparts/" class="hud-panel p-6 block group">
          <span class="text-[10px] font-bold px-2 py-0.5 rounded" style="background: var(--color-gold-muted); color: var(--color-gold);">B2B Auto Parts (SEJ)</span>
          <h3 class="text-base font-bold my-2 group-hover:text-[var(--color-gold)]" style="color: var(--color-text-primary);">$1.8M Wholesale Pipeline Generated</h3>
          <p class="text-xs" style="color: var(--color-text-muted);">120k faceted URL cleanup, OEM interchange schema, +350% RFQs.</p>
        </a>

        <a href="/case-studies/colorbombwraps/" class="hud-panel p-6 block group">
          <span class="text-[10px] font-bold px-2 py-0.5 rounded" style="background: var(--color-gold-muted); color: var(--color-gold);">Local Fleet & Wraps</span>
          <h3 class="text-base font-bold my-2 group-hover:text-[var(--color-gold)]" style="color: var(--color-text-primary);">#1 Google Maps 3-Pack Across 18 Zips</h3>
          <p class="text-xs" style="color: var(--color-text-muted);">+540% phone calls, commercial fleet contracts, 5.0★ local rating.</p>
        </a>
      </div>
    </div>

    <!-- FAQ Accordion Section -->
    <div class="mb-20">
      <FaqSection items={faqs} title="Automotive SEO Services — Frequently Asked Questions" />
    </div>

    <!-- Consultation CTA -->
    <div class="hud-panel p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
        Ready to engineer your automotive search dominance?
      </h2>
      <p class="text-sm sm:text-base max-w-xl mx-auto mb-8" style="color: var(--color-text-secondary);">
        Partner with the specialist automotive search agency trusted by global brands, wholesale distributors, and multi-location dealer groups.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary text-sm font-bold py-3.5 px-8 rounded-xl shadow-xl w-full sm:w-auto">
          Schedule Strategy Consultation →
        </a>
        <a href="/audit/" class="btn-gold text-sm font-bold py-3.5 px-8 rounded-xl w-full sm:w-auto">
          Run Free Automotive Audit
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

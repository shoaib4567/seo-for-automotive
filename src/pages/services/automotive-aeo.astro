---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import AutomotiveAiCitationSimulator from '../../components/interactive/AutomotiveAiCitationSimulator.jsx';
import AutomotiveSerpAnatomy from '../../components/visuals/AutomotiveSerpAnatomy.astro';
import AutomotiveDeliverablesMatrix from '../../components/visuals/AutomotiveDeliverablesMatrix.astro';
import AutomotiveArchitectureDiagram from '../../components/visuals/AutomotiveArchitectureDiagram.astro';
import ComparisonMatrix from '../../components/visuals/ComparisonMatrix.astro';
import ExecutionRoadmapTabs from '../../components/interactive/ExecutionRoadmapTabs.jsx';
import InteractiveSchemaSnippet from '../../components/interactive/InteractiveSchemaSnippet.jsx';

const title = "AEO for Automotive — Answer Engine Optimization & Google AI Overviews | SEO for Automotive";
const description = "Specialist Answer Engine Optimization (AEO) for automotive businesses. Capture #1 Featured Snippets, People Also Ask boxes, and Google AI Overview citations across vehicle and repair queries.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'AEO', href: '/services/automotive-aeo/' },
];

const pillars = [
  { title: 'Google AI Overview Citation Engineering', desc: 'Formatting factual vehicle specifications, installation protocols, and troubleshooting steps for direct inclusion in Google\'s generative search summaries.' },
  { title: 'Featured Snippet & Position Zero Capture', desc: 'Reverse-engineering Google\'s paragraph, list, and table snippet triggers for automotive cost comparisons and maintenance intervals.' },
  { title: 'People Also Ask (PAA) Network Dominance', desc: 'Building comprehensive Q&A clusters that systematically capture high-volume PAA accordions across the entire customer search journey.' },
  { title: 'Voice Search & Conversational Query Mapping', desc: 'Optimizing for voice assistants (Google Assistant, Siri, Alexa) for urgent vehicle repair and localized "near me" voice searches.' },
];

const faqs = [
  {
    question: 'What is AEO (Answer Engine Optimization) and why is it critical for automotive brands?',
    answer: 'AEO is the practice of structuring content so search engines can directly extract answers for zero-click searches, Featured Snippets, and AI Overviews. When car owners search "How much does brake pad replacement cost?" or "Is ceramic coating worth it on new paint?", Google displays a direct answer. If your brand provides that answer, you earn unmatched authority and trust.'
  },
  {
    question: 'How did you secure 45+ Google AI Overview citations in your case studies?',
    answer: 'In our <a href="/case-studies/vinylfrog/">VinylFrog Case Study</a>, we structured definitive technical fact triples, side-by-side comparison tables, and certified installer credentials. Google\'s RAG (Retrieval-Augmented Generation) pipeline selected VinylFrog as the primary cited source across dozens of high-intent queries.'
  },
  {
    question: 'How do you measure AEO ROI compared to traditional SEO clicks?',
    answer: 'While AI Overviews reduce low-intent casual clicks, they concentrate ultra-high-intent traffic directly onto cited brand domains. Visitors arriving via AI Overview citations convert at 2.4x the rate of standard organic searchers.'
  }
];
---

<BaseLayout title={title} description={description} canonicalPath="/services/automotive-aeo/" breadcrumbs={breadcrumbs}>
  <div class="max-w-6xl mx-auto">
    
    <!-- Hero Header -->
    <div class="mb-14">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge-outline">Next-Gen Search</span>
        <span class="eeat-badge">45+ AI Overviews</span>
        <span class="live-badge"><span class="live-dot"></span> Zero-Click &amp; Position Zero Dominance</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black leading-tight mb-6" style="color: var(--color-text-primary);">
        AEO for Automotive: <span class="text-gradient-gold">Answer Engine &amp; AI Overview Optimization</span>
      </h1>
      
      <p class="text-lg sm:text-xl leading-relaxed max-w-3xl" style="color: var(--color-text-secondary);">
        Automotive Answer Engine Optimization (AEO) is the specialized process of formatting and encoding automotive technical content, maintenance intervals, and buyer specifications so search engines directly extract your data for Google AI Overviews, Featured Snippets, and voice search answers.
      </p>
    </div>

    <!-- The Direct Answer Callout Box (Citelx formula) -->
    <div class="hud-panel p-6 sm:p-8 rounded-2xl border-l-4 mb-14" style="border-left-color: var(--color-gold); background: var(--color-bg-surface);">
      <p class="text-base sm:text-lg leading-relaxed font-medium" style="color: var(--color-text-primary);">
        AEO for automotive makes Google cite your dealership lot, repair shop, or parts brand as the verified source inside the AI answer box that now sits above the blue links. It works on machine-readable technical specs, diagnostic protocols, and direct answer definitions—because those are what Google's generative models quote, not marketing fluff.
      </p>
    </div>

    <!-- Interactive AI Citation Simulator -->
    <div class="my-14">
      <AutomotiveAiCitationSimulator client:load defaultCategory="repair" />
    </div>

    <!-- Visual SERP Anatomy -->
    <div class="my-14">
      <AutomotiveSerpAnatomy
        title="Why AEO Is Non-Negotiable in 2026"
        subtitle="When car owners search for repairs or vehicle specs, Google AI answers immediately. If your shop isn't cited, you are invisible."
      />
    </div>

    <!-- Metrics -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">45+</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">AI Overview Citations</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">60+</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Featured Snippets</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">+380%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Traffic Lift</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">#1</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Position Zero Share</div>
      </div>
    </div>

    <!-- AI Overview Citation Funnel Diagram -->
    <div class="my-14">
      <AutomotiveArchitectureDiagram
        type="aeo-citation"
        title="Google AI Overview &amp; RAG Citation Architecture"
        subtitle="How our semantic entity structure routes your automotive data into Google's generative answer boxes."
      />
    </div>

    <!-- Concrete Deliverables Matrix -->
    <div class="my-16">
      <AutomotiveDeliverablesMatrix
        title="Concrete AEO Deliverables"
        subtitle="From structured direct-answer briefs to verified technician quotes, here is what builds your AI search moat."
      />
    </div>

    <!-- 4 Pillars -->
    <div class="mb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pillars.map(p => (
          <div class="hud-panel p-6">
            <h3 class="text-lg font-bold mb-2" style="color: var(--color-text-primary);">{p.title}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-secondary);">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Agency Benchmark Matrix -->
    <div class="my-16">
      <ComparisonMatrix
        type="agency"
        title="AEO &amp; Modern Search vs Traditional SEO Agencies"
        subtitle="Why legacy keyword-stuffing agencies fail in the era of Google AI Overviews and answer engines."
      />
    </div>

    <!-- Schema Snippet -->
    <div class="my-16">
      <InteractiveSchemaSnippet client:visible />
    </div>

    <!-- Execution Roadmap Blueprint -->
    <div class="my-16">
      <ExecutionRoadmapTabs client:visible />
    </div>

    <!-- FAQ Section -->
    <div class="mb-20">
      <FaqSection items={faqs} title="Automotive AEO — Frequently Asked Questions" />
    </div>

    <!-- Consultation CTA -->
    <div class="hud-panel p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
        Capture position zero and Google AI Overview citations
      </h2>
      <p class="text-sm sm:text-base max-w-xl mx-auto mb-8" style="color: var(--color-text-secondary);">
        Schedule an Answer Engine Optimization consultation to discover high-value AI overview opportunities in your automotive niche.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary text-sm font-bold py-3.5 px-8 rounded-xl shadow-xl w-full sm:w-auto">
          Schedule AEO Strategy Call →
        </a>
        <a href="/audit/" class="btn-gold text-sm font-bold py-3.5 px-8 rounded-xl w-full sm:w-auto">
          Run Free AEO Audit
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

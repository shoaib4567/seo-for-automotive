---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import ComparisonMatrix from '../../components/visuals/ComparisonMatrix.astro';
import AutomotiveArchitectureDiagram from '../../components/visuals/AutomotiveArchitectureDiagram.astro';
import ExecutionRoadmapTabs from '../../components/interactive/ExecutionRoadmapTabs.jsx';
import InteractiveSchemaSnippet from '../../components/interactive/InteractiveSchemaSnippet.jsx';

const title = "Technical SEO for Automotive — VDP Indexation, Core Web Vitals & Schema | SEO for Automotive";
const description = "Specialist automotive technical SEO engineering. Master dynamic vehicle inventory indexation, eliminate faceted crawl waste, optimize Core Web Vitals, and deploy advanced Vehicle schema.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Technical SEO', href: '/services/automotive-technical-seo/' },
];

const technicalSolutions = [
  { title: 'Dynamic VDP & SRP Crawl Budget Optimization', desc: 'Eliminating faceted navigation spider traps, managing vehicle churn, and deploying dynamic XML inventory feeds that guarantee 99.8% indexation efficiency.', icon: 'wrench' },
  { title: 'Advanced Automotive Schema.org Architecture', desc: 'Nested Vehicle, AutoDealer, AutoRepair, Product, Offer, and AggregateRating JSON-LD schema linking your inventory directly into Google\'s Knowledge Vault.', icon: 'code' },
  { title: 'JavaScript Rendering & Hydration for DMS/CDK/Dealer.com', desc: 'Solving headless inventory rendering bottlenecks, ensuring bot-ready pre-rendered HTML on Dealer.com, CDK Global, DealerSocket, and custom stacks.', icon: 'server' },
  { title: 'Core Web Vitals & Real-Time Performance Tuning', desc: 'Sub-second LCP image optimization for 360-degree vehicle walkarounds, CLS elimination on dynamic price calculators, and sub-100ms INP response.', icon: 'bolt' },
];

const faqs = [
  {
    question: 'Why do vehicle inventory pages (VDPs) get dropped from Google\'s index so frequently?',
    answer: 'Automotive dealerships experience 20-40% monthly inventory churn. When cars sell, typical DMS systems generate 404 errors or soft-404 empty pages. Search bots waste crawl budget on sold cars while failing to discover newly arrived models. We implement automated inventory status codes (<code>HTTP 410 Gone</code> or 301 redirects to parent category) and dynamic XML sitemaps synced in real-time with your DMS inventory feed.'
  },
  {
    question: 'Can you fix SEO on proprietary platforms like Dealer.com, CDK Global, or DealerInspire?',
    answer: 'Yes. We have deep platform experience with CDK Global, Dealer.com, DealerInspire, DealerSocket, WordPress, Shopify Plus, and custom headless Astro/Next.js automotive stacks. We deploy custom tag-manager schema injections, canonical surgery, and client-side rendering overrides that resolve platform limitations.'
  },
  {
    question: 'How do you optimize 360-degree vehicle image spinners without hurting Core Web Vitals?',
    answer: 'We defer high-resolution multi-angle image arrays behind WebP/AVIF progressive hydration triggers, loading the primary hero angle in under 1.0s (LCP) while lazy-loading secondary interior and angle assets only upon user touch interaction.'
  }
];
---

<BaseLayout title={title} description={description} canonicalPath="/services/automotive-technical-seo/" breadcrumbs={breadcrumbs}>
  <div class="max-w-6xl mx-auto">
    
    <!-- Hero Header -->
    <div class="mb-14">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge-outline">Technical Architecture</span>
        <span class="eeat-badge">99.8% Crawl Efficiency</span>
        <span class="live-badge"><span class="live-dot"></span> DMS &amp; CDK Integration</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black leading-tight mb-6" style="color: var(--color-text-primary);">
        Automotive Technical SEO: <span class="text-gradient-gold">VDP Indexation &amp; Schema Architecture</span>
      </h1>
      
      <p class="text-lg sm:text-xl leading-relaxed max-w-3xl" style="color: var(--color-text-secondary);">
        Automotive technical SEO is the engineering discipline of optimizing dynamic vehicle detail pages (VDPs), faceted inventory filters, and Dealer Management System (DMS) feeds to guarantee 99.8%+ indexation efficiency, eliminate crawl budget waste, and deploy machine-readable Schema.org Vehicle data that search engines and AI models can parse without rendering errors.
      </p>
    </div>

    <!-- Technical Architecture Diagram Banner -->
    <div class="relative rounded-2xl overflow-hidden border shadow-2xl mb-16" style="border-color: var(--color-border); background: var(--color-bg-card);">
      <img
        src="/aeo-knowledge-graph.jpg"
        alt="Automotive Technical Schema and Knowledge Vault Architecture"
        class="w-full h-auto object-cover"
        loading="eager"
      />
      <div class="p-4 border-t flex flex-wrap items-center justify-between gap-3 text-xs" style="border-color: var(--color-border); background: var(--color-bg-surface);">
        <span class="font-bold flex items-center gap-2" style="color: var(--color-text-primary);">
          <span class="live-dot"></span> Machine-Readable Entity Schematics &amp; Schema.org AutoDealer Vocabulary
        </span>
        <span class="text-[11px] font-semibold" style="color: var(--color-gold);">100% W3C &amp; Schema.org Compliant</span>
      </div>
    </div>

    <!-- Metrics Proof -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">99.8%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">VDP Indexation Rate</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">&lt; 1.2s</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Core Web Vitals LCP</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">120k+</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Faceted Crawl Errors Fixed</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">100%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Schema Rich Results</div>
      </div>
    </div>

    <!-- Dealership Platform Comparison Matrix -->
    <div class="my-16">
      <ComparisonMatrix
        type="cms-platforms"
        title="Automotive Platform &amp; CMS Performance Benchmark"
        subtitle="How traditional dealer platforms (Dealer.com, CDK, DealerOn) compare against modern headless web architectures."
      />
    </div>

    <!-- Dynamic Inventory Architecture Diagram -->
    <div class="my-14">
      <AutomotiveArchitectureDiagram
        type="dealership-entity"
        title="Dynamic Inventory &amp; VDP Crawl Routing Architecture"
        subtitle="Automated DMS sitemap synchronization that prevents crawl waste on sold units."
      />
    </div>

    <!-- 4 Core Technical Solutions -->
    <div class="mb-20">
      <div class="mb-10 text-center max-w-2xl mx-auto">
        <span class="eeat-badge mb-2">Technical Engineering</span>
        <h2 class="text-2xl sm:text-3xl font-bold mt-2" style="color: var(--color-text-primary);">
          Core Automotive Technical Capabilities
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {technicalSolutions.map(sol => (
          <div class="hud-panel p-6">
            <h3 class="text-lg font-bold mb-2" style="color: var(--color-text-primary);">{sol.title}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-secondary);">{sol.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Schema Snippet -->
    <div class="my-16">
      <InteractiveSchemaSnippet client:visible />
    </div>

    <!-- Execution Roadmap Blueprint -->
    <div class="my-16">
      <ExecutionRoadmapTabs client:visible />
    </div>

    <!-- FAQ Section -->
    <div class="mb-20">
      <FaqSection items={faqs} title="Automotive Technical SEO — Frequently Asked Questions" />
    </div>

    <!-- Consultation CTA -->
    <div class="hud-panel p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
        Eliminate crawl errors and accelerate inventory indexation
      </h2>
      <p class="text-sm sm:text-base max-w-xl mx-auto mb-8" style="color: var(--color-text-secondary);">
        Get a full technical crawl budget and structured data diagnostic for your automotive website.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary text-sm font-bold py-3.5 px-8 rounded-xl shadow-xl w-full sm:w-auto">
          Schedule Technical SEO Call →
        </a>
        <a href="/audit/" class="btn-gold text-sm font-bold py-3.5 px-8 rounded-xl w-full sm:w-auto">
          Run Instant Speed Audit
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

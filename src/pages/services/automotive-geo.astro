---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqSection from '../../components/FaqSection.astro';
import AutomotiveAiCitationSimulator from '../../components/interactive/AutomotiveAiCitationSimulator.jsx';
import AutomotiveBuyerJourneyFlow from '../../components/visuals/AutomotiveBuyerJourneyFlow.astro';
import AutomotiveDeliverablesMatrix from '../../components/visuals/AutomotiveDeliverablesMatrix.astro';
import AutomotiveArchitectureDiagram from '../../components/visuals/AutomotiveArchitectureDiagram.astro';
import ComparisonMatrix from '../../components/visuals/ComparisonMatrix.astro';
import ExecutionRoadmapTabs from '../../components/interactive/ExecutionRoadmapTabs.jsx';
import InteractiveSchemaSnippet from '../../components/interactive/InteractiveSchemaSnippet.jsx';

const title = "GEO for Automotive — Generative Engine Optimization & LLM Visibility | SEO for Automotive";
const description = "Specialist Generative Engine Optimization (GEO) for automotive businesses. Get your automotive brand recommended and cited by ChatGPT, Google Gemini, Perplexity, and Apple Intelligence.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'GEO', href: '/services/automotive-geo/' },
];

const pillars = [
  { title: 'Brand Entity Embedding & Vectorization', desc: 'Establishing your dealership, parts brand, or repair shop as an authoritative entity in public knowledge repositories and LLM training corpora.' },
  { title: 'Citation-Worthy Original Data & Testing', desc: 'Publishing definitive comparison benchmarks, automotive lab tests, and technical specs that LLMs systematically cite as primary sources.' },
  { title: 'Cross-Platform Entity Consistency & Digital PR', desc: 'Managing entity mentions across automotive forums, Reddit, YouTube, industry trade publications, and authoritative review ecosystems.' },
  { title: 'Multi-Modal AI Search Alignment', desc: 'Optimizing vehicle photography, video walkarounds, and structured product attributes for multi-modal visual search in Gemini and ChatGPT-4o.' },
];

const faqs = [
  {
    question: 'How is GEO (Generative Engine Optimization) different from traditional SEO?',
    answer: 'Traditional SEO targets keyword rankings on search engine result pages. GEO targets citation frequency and recommendation probability within Large Language Models (LLMs) like ChatGPT, Gemini, Perplexity, and Copilot. When a prospective buyer prompts "What\'s the most reliable brake pad brand for heavy towing?" or "Find the top-rated PPF installer near me", GEO ensures your brand is the synthesized answer.'
  },
  {
    question: 'How do LLMs decide which automotive businesses to recommend?',
    answer: 'LLMs rely on vector proximity across training data and real-time RAG (Retrieval-Augmented Generation). They evaluate entity consensus across trusted web directories, verified Schema.org structured data, consistent customer review sentiment, and citations from authoritative third-party automotive media.'
  }
];
---

<BaseLayout title={title} description={description} canonicalPath="/services/automotive-geo/" breadcrumbs={breadcrumbs}>
  <div class="max-w-6xl mx-auto">
    
    <!-- Hero Header -->
    <div class="mb-14">
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="badge-outline">Generative Search Intelligence</span>
        <span class="eeat-badge">LLM Vectorization</span>
        <span class="live-badge"><span class="live-dot"></span> ChatGPT, Gemini &amp; Perplexity</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl font-black leading-tight mb-6" style="color: var(--color-text-primary);">
        GEO for Automotive: <span class="text-gradient-gold">Generative Engine Optimization &amp; AI Citations</span>
      </h1>
      
      <p class="text-lg sm:text-xl leading-relaxed max-w-3xl" style="color: var(--color-text-secondary);">
        Automotive Generative Engine Optimization (GEO) is the systematic process of structuring your automotive brand's entity data, technical specifications, and cross-platform verification signals so AI search engines like ChatGPT, Google Gemini, and Perplexity actively recommend and cite your business.
      </p>
    </div>

    <!-- The Direct Answer Callout Box (Citelx formula) -->
    <div class="hud-panel p-6 sm:p-8 rounded-2xl border-l-4 mb-14" style="border-left-color: var(--color-gold); background: var(--color-bg-surface);">
      <p class="text-base sm:text-lg leading-relaxed font-medium" style="color: var(--color-text-primary);">
        The automotive brand AI recommends is the one it can verify. GEO establishes your dealership, repair shop, or parts brand across vector embeddings, public automotive knowledge graphs, and trusted review feeds so when buyers ask ChatGPT or Gemini for recommendations, your business is the synthesized answer.
      </p>
    </div>

    <!-- Interactive AI Citation Simulator -->
    <div class="my-14">
      <AutomotiveAiCitationSimulator client:load defaultCategory="dealership" />
    </div>

    <!-- 6-Stage Buyer Journey Flow -->
    <div class="my-14">
      <AutomotiveBuyerJourneyFlow
        title="Where GEO Influences the Automotive Buyer Arc"
        subtitle="From initial discovery on social search to final shortlisting inside conversational LLMs."
      />
    </div>

    <!-- Metrics -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-16">
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">100%</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Entity Verification</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">4x</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">AI Citation Velocity</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">45+</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">LLM Brand Mentions</div>
      </div>
      <div class="hud-panel p-5 text-center">
        <div class="text-3xl font-black" style="color: var(--color-gold);">#1</div>
        <div class="text-xs font-semibold mt-1" style="color: var(--color-text-muted);">Recommended Brand</div>
      </div>
    </div>

    <!-- AI Overview & Citation Pipeline Diagram -->
    <div class="my-14">
      <AutomotiveArchitectureDiagram
        type="aeo-citation"
        title="Generative AI (ChatGPT, Gemini, Perplexity) Recommendation Pipeline"
        subtitle="How our entity vectorization ensures your automotive brand is synthesized as the #1 recommended solution."
      />
    </div>

    <!-- Concrete Deliverables Matrix -->
    <div class="my-16">
      <AutomotiveDeliverablesMatrix
        title="Concrete GEO Deliverables"
        subtitle="Machine-readable entity datasets and verified proprietary briefs that establish LLM citation dominance."
      />
    </div>

    <!-- 4 Pillars -->
    <div class="mb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pillars.map(p => (
          <div class="hud-panel p-6">
            <h3 class="text-lg font-bold mb-2" style="color: var(--color-text-primary);">{p.title}</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-text-secondary);">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Agency Benchmark Matrix -->
    <div class="my-16">
      <ComparisonMatrix
        type="agency"
        title="Generative AI Search Readiness: Specialist vs Legacy Agencies"
        subtitle="Compare how proactive entity engineering outperforms traditional keyword tactics in AI engines."
      />
    </div>

    <!-- Schema Snippet -->
    <div class="my-16">
      <InteractiveSchemaSnippet client:visible />
    </div>

    <!-- Execution Roadmap Blueprint -->
    <div class="my-16">
      <ExecutionRoadmapTabs client:visible />
    </div>

    <!-- FAQ Section -->
    <div class="mb-20">
      <FaqSection items={faqs} title="Automotive GEO — Frequently Asked Questions" />
    </div>

    <!-- Consultation CTA -->
    <div class="hud-panel p-8 sm:p-12 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3" style="color: var(--color-text-primary);">
        Get your automotive brand cited in ChatGPT and Gemini
      </h2>
      <p class="text-sm sm:text-base max-w-xl mx-auto mb-8" style="color: var(--color-text-secondary);">
        Schedule a Generative Engine Optimization consultation to establish permanent AI search visibility for your automotive business.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary text-sm font-bold py-3.5 px-8 rounded-xl shadow-xl w-full sm:w-auto">
          Schedule GEO Strategy Call →
        </a>
        <a href="/audit/" class="btn-gold text-sm font-bold py-3.5 px-8 rounded-xl w-full sm:w-auto">
          Run Free AI Search Audit
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuditTool from '../components/AuditTool.jsx';

const title = "Free Automotive SEO Audit Tool | SEO for Automotive";
const description = "Get an instant, free SEO audit for your automotive website. Analyzes technical SEO, Core Web Vitals, meta tags, schema markup, AEO/GEO readiness, and CRO signals — built specifically for automotive businesses.";
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Free SEO Audit', href: '/audit/' },
];
---

<BaseLayout title={title} description={description} canonicalPath="/audit/" breadcrumbs={breadcrumbs}>

  <div class="max-w-3xl mx-auto">
    <div class="mb-10">
      <span class="badge-outline mb-3">Free Instant Analysis</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight mt-2" style="color: var(--color-text-primary);">
        Free Automotive <span class="text-gradient-gold">SEO Audit</span>
      </h1>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-text-secondary);">
        Enter your website URL below and get an instant analysis of your technical SEO, Core Web Vitals, meta tags, structured data, AEO & GEO readiness, and conversion signals — built specifically for automotive websites.
      </p>
    </div>

    <!-- What we analyze -->
    <div class="glass-panel rounded-xl p-6 mb-8">
      <h2 class="text-lg font-bold mb-4" style="color: var(--color-text-primary);">What this audit analyzes</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full flex items-center justify-center text-xs shrink-0 mt-0.5" style="background: var(--color-gold-muted); color: var(--color-gold);">✓</span>
          <div>
            <div class="text-sm font-medium" style="color: var(--color-text-primary);">Technical SEO</div>
            <div class="text-xs" style="color: var(--color-text-muted);">HTTPS, mobile, Core Web Vitals, titles, meta</div>
          </div>
        </div>
        <div class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full flex items-center justify-center text-xs shrink-0 mt-0.5" style="background: var(--color-gold-muted); color: var(--color-gold);">✓</span>
          <div>
            <div class="text-sm font-medium" style="color: var(--color-text-primary);">SEO Analysis</div>
            <div class="text-xs" style="color: var(--color-text-muted);">Google SEO score, canonical, robots, schema</div>
          </div>
        </div>
        <div class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full flex items-center justify-center text-xs shrink-0 mt-0.5" style="background: var(--color-secondary-muted); color: var(--color-secondary);">✓</span>
          <div>
            <div class="text-sm font-medium" style="color: var(--color-text-primary);">AEO & GEO Readiness</div>
            <div class="text-xs" style="color: var(--color-text-muted);">AI Overview, answer engine, LLM optimization</div>
          </div>
        </div>
        <div class="flex items-start gap-2.5">
          <span class="w-5 h-5 rounded-full flex items-center justify-center text-xs shrink-0 mt-0.5" style="background: var(--color-secondary-muted); color: var(--color-secondary);">✓</span>
          <div>
            <div class="text-sm font-medium" style="color: var(--color-text-primary);">CRO & UX</div>
            <div class="text-xs" style="color: var(--color-text-muted);">Accessibility, best practices, mobile usability</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Audit Tool (React, client-only rendering) -->
    <AuditTool client:only="react" />
  </div>

</BaseLayout>

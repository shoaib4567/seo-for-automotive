---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InternalLinkCard from '../../components/InternalLinkCard.astro';
import FaqSection from '../../components/FaqSection.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import AutomotiveArchitectureDiagram from '../../components/visuals/AutomotiveArchitectureDiagram.astro';
import ComparisonMatrix from '../../components/visuals/ComparisonMatrix.astro';
import InteractiveSchemaSnippet from '../../components/interactive/InteractiveSchemaSnippet.jsx';

const title = "Semantic SEO & Automotive Entities: Schema, Knowledge Graph & Architecture [2026]";
const description = "Master semantic SEO for automotive websites. Implement Schema.org Vehicle and AutoDealer entities, Knowledge Graph mapping, and machine-readable data structures.";
const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Knowledge Hub', href: '/blog/automotive-seo-strategy/' }, { label: 'Semantic SEO', href: '/blog/semantic-seo-entities/' }];
const relatedLinks = [
  { title: 'E-E-A-T Guide for Automotive', href: '/blog/eeat-automotive-seo/', description: 'Entity trust, technician certifications, and authority signals.' },
  { title: 'AEO — Answer Engine Optimization', href: '/blog/aeo-answer-engine-optimization/', description: 'Winning featured snippets with entity clarity.' },
  { title: 'GEO — Generative Engine Optimization', href: '/blog/geo-generative-engine-optimization/', description: 'Structuring entity attributes for AI citations.' },
  { title: 'Content SEO Playbook', href: '/blog/content-seo-automotive/', description: 'Entity-first automotive content architectures.' },
  { title: 'Holistic SEO Framework', href: '/blog/holistic-seo-automotive/', description: 'Unified technical and commercial search architecture.' },
  { title: 'Car Dealership SEO Services', href: '/industries/car-dealership-seo/', description: 'Vehicle entity optimization for franchised dealer groups.' },
];

const faqs = [
  { question: 'What is semantic SEO in the automotive industry?', answer: 'Semantic SEO is the practice of structuring website content and metadata around real-world automotive entities (makes, models, VINs, trims, OEM part numbers, dealership locations) and their relationships, rather than optimizing solely for isolated keywords. This enables Google and AI search engines to interpret and cite the data accurately.' },
  { question: 'What Schema.org types are required for automotive websites?', answer: 'Automotive websites require nested Schema.org structures including Vehicle, AutoDealer, AutoRepair, AutoBodyShop, Product (with mpn, gtin13, sku), Service, Offer, FAQPage, and Review vocabularies.' },
];
---

<BaseLayout title={title} description={description} canonicalPath="/blog/semantic-seo-entities/" breadcrumbs={breadcrumbs}>
  <div class="mb-12">
    <div class="flex items-center gap-3 mb-4">
      <span class="px-2.5 py-0.5 text-[10px] font-bold text-cyan-500 dark:text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 rounded-full uppercase">Knowledge Hub</span>
      <span class="px-2.5 py-0.5 text-[10px] font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10 border border-amber-500/20 rounded-full uppercase">Entity Architecture</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black leading-tight" style="color: var(--color-text-primary);">Semantic SEO &amp; <span class="text-gradient-gold">Automotive Knowledge Entities</span></h1>
    <p class="mt-4 text-lg max-w-3xl" style="color: var(--color-text-secondary);">
      Semantic SEO is the optimization method that structures automotive web pages around distinct entities—such as vehicle makes, models, VIN identifiers, and dealership facilities—enabling Google's Knowledge Graph and generative AI engines to verify factual authority and rank pages above generic aggregators.
    </p>
  </div>

  <!-- Multi-Department Entity Diagram -->
  <div class="my-12">
    <AutomotiveArchitectureDiagram
      type="dealership-entity"
      title="Automotive Knowledge Graph &amp; Entity Hierarchy"
      subtitle="How nested vehicle and dealership entities map directly into Google's Knowledge Graph."
    />
  </div>

  <div class="prose-content">
    <h2>Moving From Strings to Things in Automotive Search</h2>
    <p>
      Search engines no longer match strings of text against keyword databases. Google's algorithms parse entities: unique, identifiable concepts defined by their attributes and connections to other entities.
    </p>
    <p>
      When a searcher inputs "used 2023 ford f150 lariat under 45k near me", the search engine evaluates four distinct entity layers simultaneously:
    </p>
    <ul>
      <li><strong>Brand Entity:</strong> Ford Motor Company (Wikidata ID: Q44294)</li>
      <li><strong>Product Entity:</strong> Ford F-Series / F-150 (Wikidata ID: Q241477)</li>
      <li><strong>Temporal &amp; Trim Attributes:</strong> Model Year 2023, Trim Level "Lariat", Price ceiling $45,000</li>
      <li><strong>Geographic &amp; Business Entity:</strong> Licensed AutoDealer within the searcher's physical radius</li>
    </ul>

    <h2>Essential Automotive Schema.org Types</h2>
    
    <h3>1. Vehicle Schema on Inventory Pages</h3>
    <p>
      Every Vehicle Detail Page (VDP) must output microdata or JSON-LD utilizing the Schema.org <code>Vehicle</code> or <code>Car</code> type. Critical properties include:
    </p>
    <ul>
      <li><code>vehicleIdentificationNumber</code> (VIN) for unique indexation</li>
      <li><code>brand</code> (Organization entity)</li>
      <li><code>model</code>, <code>modelDate</code> (Year), and <code>vehicleConfiguration</code> (Trim)</li>
      <li><code>mileageFromOdometer</code> (QuantitativeValue with unitCode "SMI")</li>
      <li><code>fuelType</code>, <code>driveWheelConfiguration</code>, and <code>itemCondition</code></li>
      <li><code>offers</code> (Offer schema detailing exact price, currency, and availability)</li>
    </ul>

    <h3>2. AutoDealer &amp; AutoRepair Multi-Department Schema</h3>
    <p>
      Franchised dealerships require distinct schema declarations for each functional department. Linking these via <code>department</code> and <code>parentOrganization</code> relationships establishes unambiguous local entity boundaries.
    </p>

    <h3>3. Product &amp; Part Number Schema (ACES/PIES Fitment)</h3>
    <p>
      For automotive parts manufacturers and eCommerce catalogs, part number taxonomy is foundational. Schema.org <code>Product</code> must specify <code>mpn</code> (Manufacturer Part Number), <code>gtin13</code>, and cross-reference vehicle fitment compatibility matrices.
    </p>
  </div>

  <!-- Interactive Schema Code Inspector -->
  <div class="my-16">
    <InteractiveSchemaSnippet client:visible />
  </div>

  <!-- CMS Platform Comparison Matrix -->
  <div class="my-16">
    <ComparisonMatrix
      type="cms-platforms"
      title="Platform Schema Capability Benchmark"
      subtitle="How modern headless search architectures provide 100% granular schema control compared to legacy dealer CMSs."
    />
  </div>

  <FaqSection items={faqs} title="Frequently Asked Questions on Automotive Semantic SEO" />

  <div class="mt-12">
    <h2 class="text-xl font-bold mb-6" style="color: var(--color-text-primary);">Related Knowledge Hub Pages</h2>
    <InternalLinkCard links={relatedLinks} columns={3} />
  </div>

  <div class="mt-12">
    <AuthorCard 
      name="Automotive Search Engineering Team" 
      role="Semantic Search &amp; Knowledge Graph Architects" 
      bio="Specializing in Schema.org structured data engineering, vehicle entity graphs, and Knowledge Graph validation for automotive enterprises." 
      expertise={['Schema.org Vehicle Vocabularies', 'Knowledge Graph Architecture', 'ACES/PIES Fitment SEO', 'Entity-Based Content Strategy']} 
    />
  </div>
</BaseLayout>
